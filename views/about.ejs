    <!-- ===== JAVASCRIPT ===== -->
    <script>
        // ===== DYNAMIC YEAR =====
        document.getElementById('year').textContent = new Date().getFullYear();

        // ===== DOM REFERENCES =====
        const termsModal = document.getElementById('termsModal');
        const closeTermsModalBtn = document.getElementById('closeTermsModal');
        const termsCheckbox = document.getElementById('termsCheckbox');
        const btnAcceptTerms = document.getElementById('btnAcceptTerms');
        const termsCheckboxWrapper = document.getElementById('termsCheckboxWrapper');

        const founderModal = document.getElementById('founderModal');
        const closeFounderModalBtn = document.getElementById('closeFounderModal');
        const founderModalTitle = document.getElementById('founderModalTitle');
        const founderModalRole = document.getElementById('founderModalRole');
        const founderModalBody = document.getElementById('founderModalBody');
        const founderModalAvatar = document.getElementById('founderModalAvatar');

        const contactModal = document.getElementById('contactModal');
        const closeContactModalBtn = document.getElementById('closeContactModal');
        const navContactTrigger = document.getElementById('navContactTrigger');
        const footerContactTrigger = document.getElementById('footerContactTrigger');

        const allModals = [termsModal, founderModal, contactModal];
        const bodyEl = document.body;

        // ===== FOUNDER DATA =====
        const founderData = {
            abhishank: {
                name: 'Abhishank',
                role: 'Founder &amp; Backend Developer',
                roleClass: 'lead-tag',
                avatar: '👤',
                body: '<strong>Abhishank</strong> is the visionary <strong>Founder</strong> of Periodic Instructor. He built the entire <strong>backend infrastructure</strong> of this website, ensuring fast, secure, and reliable performance. His expertise in server-side development, database management, and system architecture powers everything behind the scenes. Abhishank\'s passion for chemistry education drives the mission of ASR Group forward.'
            },
            rachit: {
                name: 'Rachit',
                role: 'Co-Founder &amp; UI/UX Designer',
                roleClass: '',
                avatar: '👤',
                body: '<strong>Rachit</strong> is the creative force behind Periodic Instructor\'s <strong>user interface and user experience design</strong>. He meticulously crafted the visual layout, interactive elements, and overall look-and-feel of the website. His design philosophy ensures that every learner enjoys an intuitive, beautiful, and seamless browsing experience while exploring the Periodic Table.'
            },
            suryansh: {
                name: 'Suryansh',
                role: 'Co-Founder &amp; UI/UX Designer',
                roleClass: '',
                avatar: '👤',
                body: '<strong>Suryansh</strong> co-designed the <strong>user interface and user experience</strong> of Periodic Instructor. He focused on crafting clean layouts, responsive design patterns, and engaging visual elements that make learning chemistry a delight. His attention to detail ensures the platform looks great and works flawlessly across all devices.'
            }
        };

        // ===== UTILITY: OPEN MODAL =====
        function openModal(modal) {
            modal.classList.add('active');
            bodyEl.classList.add('no-scroll');
            // Focus the close button for accessibility
            const closeBtn = modal.querySelector('.modal-close-btn');
            if (closeBtn) {
                setTimeout(() => closeBtn.focus(), 100);
            }
        }

        // ===== UTILITY: CLOSE MODAL =====
        function closeModal(modal) {
            modal.classList.remove('active');
            bodyEl.classList.remove('no-scroll');
        }

        // ===== UTILITY: CLOSE ALL MODALS =====
        function closeAllModals() {
            allModals.forEach(m => closeModal(m));
        }

        // ===== CLOSE MODALS ON OVERLAY CLICK =====
        allModals.forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeModal(modal);
                }
            });
        });

        // ===== CLOSE MODALS ON ESCAPE KEY =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const activeModal = allModals.find(m => m.classList.contains('active'));
                if (activeModal) {
                    closeModal(activeModal);
                }
            }
        });

        // ===== TERMS MODAL LOGIC =====
        const TERMS_STORAGE_KEY = 'periodicInstructor_termsAccepted';

        function hasAcceptedTerms() {
            return localStorage.getItem(TERMS_STORAGE_KEY) === 'true';
        }

        function setTermsAccepted() {
            localStorage.setItem(TERMS_STORAGE_KEY, 'true');
        }

        function updateAcceptButtonState() {
            if (termsCheckbox.checked) {
                btnAcceptTerms.classList.add('enabled');
                btnAcceptTerms.disabled = false;
            } else {
                btnAcceptTerms.classList.remove('enabled');
                btnAcceptTerms.disabled = true;
            }
        }

        // Checkbox change
        termsCheckbox.addEventListener('change', updateAcceptButtonState);

        // Click on checkbox wrapper toggles the checkbox
        termsCheckboxWrapper.addEventListener('click', function(e) {
            if (e.target !== termsCheckbox) {
                termsCheckbox.checked = !termsCheckbox.checked;
                termsCheckbox.dispatchEvent(new Event('change'));
            }
        });

        // Close terms modal
        closeTermsModalBtn.addEventListener('click', function() {
            closeModal(termsModal);
            // Reset checkbox
            termsCheckbox.checked = false;
            updateAcceptButtonState();
        });

        // Accept button click
        btnAcceptTerms.addEventListener('click', function() {
            if (termsCheckbox.checked) {
                setTermsAccepted();
                closeModal(termsModal);
                // Reset checkbox for next time
                termsCheckbox.checked = false;
                updateAcceptButtonState();
                // Redirect to periodic table
                window.location.href = '/periodic_table';
            }
        });

        // ===== FOUNDER MODAL LOGIC =====
        function openFounderModal(founderKey) {
            const data = founderData[founderKey];
            if (!data) return;

            founderModalTitle.textContent = data.name;
            founderModalRole.innerHTML = data.role;
            founderModalRole.className = 'founder-role-tag' + (data.roleClass ? ' ' + data.roleClass : '');
            founderModalAvatar.textContent = data.avatar;
            founderModalBody.innerHTML = data.body;

            openModal(founderModal);
        }

        closeFounderModalBtn.addEventListener('click', function() {
            closeModal(founderModal);
        });

        // Attach click handlers to all founder badges
        document.querySelectorAll('.founder-badge').forEach(badge => {
            badge.addEventListener('click', function() {
                const founderKey = this.getAttribute('data-founder');
                openFounderModal(founderKey);
            });

            // Keyboard accessibility (Enter / Space)
            badge.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const founderKey = this.getAttribute('data-founder');
                    openFounderModal(founderKey);
                }
            });
        });

        // ===== CONTACT / INSTAGRAM MODAL LOGIC =====
        function openContactModal(e) {
            e.preventDefault();
            openModal(contactModal);
        }

        closeContactModalBtn.addEventListener('click', function() {
            closeModal(contactModal);
        });

        navContactTrigger.addEventListener('click', openContactModal);
        footerContactTrigger.addEventListener('click', openContactModal);

        // ===== INTERSECTION OBSERVER (Fade-in) =====
        (function initFadeIn() {
            const fadeElements = document.querySelectorAll('.fade-in');

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: 0.12,
                    rootMargin: '0px 0px -20px 0px'
                });

                fadeElements.forEach(el => observer.observe(el));
            } else {
                fadeElements.forEach(el => el.classList.add('visible'));
            }
        })();

        // ===== KEYBOARD TRAP PREVENTION (for modals) =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Tab') {
                const activeModal = allModals.find(m => m.classList.contains('active'));
                if (activeModal) {
                    const focusable = activeModal.querySelectorAll(
                        'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
                    );
                    if (focusable.length === 0) return;
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];

                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            }
