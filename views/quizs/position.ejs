                question: 'बोरॉन (B, Z=5) का विन्यास 1s² 2s² 2p¹ है। p-ब्लॉक, 12+1=13, समूह 13। संयोजी इलेक्ट्रॉनों की संख्या कितनी है?<br><small style="color:#94a3b8;">Boron (B, Z=5) has ...2p¹. How many valence electrons?</small>',
                options: ['A) 1', 'B) 2', 'C) 3', 'D) 5'],
                correct: 2,
                explanation: '<strong>B में 3 संयोजी इलेक्ट्रॉन हैं।</strong> बाहरी कोश (n=2): 2s² 2p¹ → कुल 2+1 = <strong>3</strong> संयोजी e⁻। p-ब्लॉक तत्व, समूह 13। B एक उपधातु (metalloid) है।'
            }, {
                id: 27,
                question: 'फ्रैंशियम (Fr, Z=87) का विन्यास [Rn] 7s¹ है। s-ब्लॉक, समूह 1, आवर्त 7। यह किस परिवार का सदस्य है?<br><small style="color:#94a3b8;">Francium (Fr, Z=87) has [Rn] 7s¹. Which family?</small>',
                options: ['A) क्षार धातु / Alkali metals', 'B) क्षारीय मृदा धातु / Alkaline earth metals',
                    'C) हैलोजन / Halogens', 'D) अक्रिय गैस / Noble gases'
                ],
                correct: 0,
                explanation: '<strong>Fr क्षार धातु (alkali metal) है।</strong> s-ब्लॉक, समूह 1 (एक संयोजी s-e⁻)। आवर्त 7। Fr अत्यधिक रेडियोधर्मी और अत्यंत दुर्लभ तत्व है। सभी समूह 1 तत्व क्षार धातु कहलाते हैं।'
            }, {
                id: 28,
                question: 'कार्बन (C, Z=6) का विन्यास 1s² 2s² 2p² है। p-ब्लॉक, 12+2=14, समूह 14। यह p-ब्लॉक में क्यों है?<br><small style="color:#94a3b8;">Why is Carbon (C, Z=6) in p-block?</small>',
                options: [
                    'A) अंतिम इलेक्ट्रॉन p-उपकोश (2p) में प्रवेश करता है / Last e⁻ enters p-subshell',
                    'B) क्योंकि यह अधातु है / Because it\'s non-metal',
                    'C) क्योंकि आवर्त 2 है / Because period is 2',
                    'D) क्योंकि 4 संयोजी e⁻ हैं / Because 4 valence e⁻'
                ],
                correct: 0,
                explanation: '<strong>C p-ब्लॉक में है क्योंकि अंतिम e⁻ 2p उपकोश में प्रवेश करता है।</strong> ब्लॉक पहचान का नियम: जिस उपकोश में अंतिम e⁻ जाए, वही ब्लॉक। C का अंतिम e⁻ 2p² में → p-ब्लॉक। समूह = 12+2 = 14, आवर्त 2।'
            }, {
                id: 29,
                question: 'रेडॉन (Rn, Z=86) का विन्यास [Xe] 4f¹⁴ 5d¹⁰ 6s² 6p⁶ है। p-ब्लॉक, 12+6=18, समूह 18। यह किस प्रकार का तत्व है?<br><small style="color:#94a3b8;">Radon (Rn, Z=86) Group 18. What type of element?</small>',
                options: ['A) क्षार धातु / Alkali metal', 'B) हैलोजन / Halogen', 'C) अक्रिय गैस / Noble gas',
                    'D) संक्रमण तत्व / Transition element'
                ],
                correct: 2,
                explanation: '<strong>Rn एक अक्रिय गैस (noble gas) है।</strong> p-ब्लॉक, समूह 18 (12+6)। आवर्त 6। Rn रेडियोधर्मी है और इसका उपयोग कैंसर चिकित्सा में होता है। सभी समूह 18 तत्व अक्रिय गैसें हैं।'
            }, {
                id: 30,
                question: 'ओगनेसन (Og, Z=118) का विन्यास [Rn] 5f¹⁴ 6d¹⁰ 7s² 7p⁶ है। p-ब्लॉक, 12+6=18, समूह 18। आवर्त संख्या क्या है?<br><small style="color:#94a3b8;">Oganesson (Og, Z=118) Group 18. What is the period number?</small>',
                options: ['A) 5', 'B) 6', 'C) 7', 'D) 8'],
                correct: 2,
                explanation: '<strong>Og की आवर्त संख्या 7 है।</strong> विन्यास में सबसे बड़ा n = <strong>7</strong> (7s² 7p⁶) है। p-ब्लॉक, p-e⁻ = 6 → समूह = 12+6 = <strong>18</strong>। Og सबसे भारी ज्ञात तत्व है (Z=118), अक्रिय गैस परिवार का सदस्य।'
            }];

            // ==================== STATE MANAGEMENT ====================
            const TOTAL = questions.length;
            let currentIndex = 0;
            // userAnswers: -1 = unanswered, -2 = skipped, 0-3 = selected option index
            let userAnswers = new Array(TOTAL).fill(-1);
            let score = 0;
            let quizCompleted = false;

            // ==================== DOM ELEMENTS ====================
            const questionContainer = document.getElementById('questionContainer');
            const progressLabel = document.getElementById('progressLabel');
            const scoreDisplay = document.getElementById('scoreDisplay');
            const progressBar = document.getElementById('progressBar');
            const prevBtn = document.getElementById('prevBtn');
            const skipBtn = document.getElementById('skipBtn');
            const nextBtn = document.getElementById('nextBtn');
            const quizWrapper = document.getElementById('quizWrapper');

            // ==================== TOAST FEEDBACK ====================
            function showToast(message, type) {
                const existing = document.querySelector('.feedback-toast');
                if (existing) existing.remove();
                const toast = document.createElement('div');
                toast.className = 'feedback-toast ' + (type === 'correct' ? 'correct-toast' : 'wrong-toast');
                toast.textContent = message;
                document.body.appendChild(toast);
                setTimeout(() => { if (toast.parentNode) toast.remove(); }, 1800);
            }

            // ==================== RENDER FUNCTION ====================
            function renderQuestion() {
                if (quizCompleted) {
                    renderResults();
                    return;
                }

                const q = questions[currentIndex];
                const userAnswer = userAnswers[currentIndex];
                const isAnswered = userAnswer >= 0;
                const isSkipped = userAnswer === -2;
                const isLocked = isAnswered || isSkipped;

                // Update progress
                const attemptedCount = userAnswers.filter(a => a >= 0 || a === -2).length;
                progressLabel.textContent = `Question ${currentIndex + 1} of ${TOTAL}`;
                scoreDisplay.textContent = `Score: ${score}`;
                progressBar.style.width = `${(attemptedCount / TOTAL) * 100}%`;
                prevBtn.disabled = currentIndex === 0;
                skipBtn.style.display = isLocked ? 'none' : 'inline-flex';
                nextBtn.textContent = currentIndex === TOTAL - 1 ? 'View Results 📊' : 'Next Question ▶';
                nextBtn.disabled = !isLocked;

                let optionsHTML = '';
                q.options.forEach((opt, i) => {
                    let btnClass = 'option-btn';
                    if (isLocked) {
                        btnClass += ' locked';
                        if (i === q.correct) {
                            btnClass += ' correct-highlight';
                        } else if (i === userAnswer && userAnswer !== q.correct) {
                            btnClass += ' wrong-highlight';
                        }
                    }
                    optionsHTML += `
                    <button class="${btnClass}" data-index="${i}" ${isLocked ? 'disabled' : ''}>
                        <span class="option-letter">${String.fromCharCode(65 + i)}</span>
                        <span class="option-text">${opt}</span>
                    </button>`;
                });

                const explanationVisible = isLocked ? 'visible' : '';

                questionContainer.innerHTML = `
                <div class="question-card" id="questionCard">
                    <span class="question-number">Question ${currentIndex + 1} / ${TOTAL}</span>
                    <div class="question-text">${q.question}</div>
                    <div class="options-list" id="optionsList">
                        ${optionsHTML}
                    </div>
                    <div class="explanation-box ${explanationVisible}" id="explanationBox">
                        <div class="explanation-label">📖 सही उत्तर की व्याख्या / Correct Answer Explanation</div>
                        ${isLocked ? q.explanation : ''}
                    </div>
                </div>`;

                // Attach click handlers if not locked
                if (!isLocked) {
                    const optionButtons = document.querySelectorAll('.option-btn');
                    optionButtons.forEach(btn => {
                        btn.addEventListener('click', function() {
                            const selectedIndex = parseInt(this.getAttribute('data-index'));
                            handleOptionSelect(selectedIndex);
                        });
                    });
                }

                // Scroll to top of card
                const card = document.getElementById('questionCard');
                if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // ==================== HANDLE OPTION SELECTION ====================
            function handleOptionSelect(selectedIndex) {
                if (userAnswers[currentIndex] >= 0) return; // already answered
                const q = questions[currentIndex];
                const isCorrect = selectedIndex === q.correct;

                // Record answer
                userAnswers[currentIndex] = selectedIndex;
                if (isCorrect) {
                    score++;
                    showToast('✅ Correct! Well done!', 'correct');
                } else {
                    showToast('❌ Wrong! See explanation below.', 'wrong');
                }

                // Update score display
                scoreDisplay.textContent = `Score: ${score}`;

                // Re-render with locked state
                renderQuestion();

                // Enable next button
                nextBtn.disabled = false;
                skipBtn.style.display = 'none';

                // Auto-scroll to explanation
                setTimeout(() => {
                    const expBox = document.getElementById('explanationBox');
                    if (expBox) expBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 300);
            }

            // ==================== SKIP HANDLER ====================
            function handleSkip() {
                if (userAnswers[currentIndex] >= 0) return;
                userAnswers[currentIndex] = -2; // mark as skipped
                const q = questions[currentIndex];
                // Show correct answer highlighted
                renderQuestion();
                nextBtn.disabled = false;
                skipBtn.style.display = 'none';
                // Scroll to explanation
                setTimeout(() => {
                    const expBox = document.getElementById('explanationBox');
                    if (expBox) expBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 300);
            }

            // ==================== NAVIGATION ====================
            function goToNext() {
                if (currentIndex < TOTAL - 1) {
                    currentIndex++;
                    renderQuestion();
                    // Scroll to top
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    // Show results
                    quizCompleted = true;
                    renderResults();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }

            function goToPrev() {
                if (currentIndex > 0) {
                    currentIndex--;
                    renderQuestion();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }

            // ==================== RESULTS PAGE ====================
            function renderResults() {
                const attempted = userAnswers.filter(a => a >= 0).length;
                const skipped = userAnswers.filter(a => a === -2).length;
                const correctCount = score;
                const percent = attempted > 0 ? Math.round((correctCount / attempted) * 100) : 0;
                const totalPercent = Math.round((correctCount / TOTAL) * 100);

                let emoji, msg;
                if (totalPercent >= 90) { emoji = '🏆';
                    msg =
                        'उत्कृष्ट! आपको आवर्त सारणी में तत्वों की स्थिति ज्ञात करने की विधि पर बहुत अच्छी पकड़ है।<br><small>Excellent! You have a strong command of finding element positions.</small>';
                } else if (totalPercent >= 70) { emoji = '🌟';
                    msg =
                        'बहुत अच्छा! आपको अधिकांश अवधारणाएँ समझ आ गई हैं। थोड़ा और अभ्यास करें।<br><small>Very good! You understand most concepts. Practice a bit more.</small>';
                } else if (totalPercent >= 50) { emoji = '📚';
                    msg =
                        'अच्छा प्रयास! कुछ अवधारणाओं पर और ध्यान देने की आवश्यकता है।<br><small>Good effort! Some concepts need more attention.</small>';
                } else { emoji = '💪';
                    msg =
                        'अभ्यास जारी रखें! s, p, d, f ब्लॉक के सूत्रों को दोबारा पढ़ें।<br><small>Keep practicing! Review the formulas for s, p, d, f blocks.</small>';
                }

                // Build mini review dots
                let dotsHTML = '';
                for (let i = 0; i < TOTAL; i++) {
                    const ans = userAnswers[i];
                    let dotClass = 'skipped';
                    if (ans >= 0) {
                        dotClass = (ans === questions[i].correct) ? 'correct' : 'wrong';
                    }
                    dotsHTML +=
                        `<span class="review-dot ${dotClass}" title="Q${i+1}: ${ans>=0 ? (ans===questions[i].correct?'Correct':'Wrong') : 'Skipped'}" onclick="reviewQuestion(${i})">${i+1}</span>`;
                }

                questionContainer.innerHTML = `
                <div class="results-card">
                    <div class="results-icon">${emoji}</div>
                    <div class="results-score">${correctCount} / ${TOTAL}</div>
                    <div class="results-outof">Attempted: ${attempted} | Skipped: ${skipped}</div>
                    <div class="results-percent">${totalPercent}% Overall Score</div>
                    <div class="results-msg">${msg}</div>
                    <div class="mini-review" id="miniReview">${dotsHTML}</div>
                    <button class="btn btn-restart" onclick="restartQuiz()">🔄 Restart Quiz</button>
                </div>`;

                // Hide nav buttons
                prevBtn.style.display = 'none';
                skipBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                progressLabel.textContent = 'Quiz Complete!';
                progressBar.style.width = '100%';
                scoreDisplay.textContent = `Final Score: ${correctCount}/${TOTAL}`;
            }

            // ==================== REVIEW SPECIFIC QUESTION ====================
            window.reviewQuestion = function(index) {
                quizCompleted = false;
                currentIndex = index;
                prevBtn.style.display = 'inline-flex';
                skipBtn.style.display = 'inline-flex';
                nextBtn.style.display = 'inline-flex';
                nextBtn.textContent = currentIndex === TOTAL - 1 ? 'View Results 📊' : 'Next Question ▶';
                nextBtn.disabled = !(userAnswers[currentIndex] >= 0 || userAnswers[currentIndex] === -2);
                skipBtn.style.display = (userAnswers[currentIndex] >= 0 || userAnswers[currentIndex] === -2) ? 'none' :
                    'inline-flex';
                prevBtn.disabled = currentIndex === 0;
                renderQuestion();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            // ==================== RESTART ====================
            window.restartQuiz = function() {
                currentIndex = 0;
                userAnswers = new Array(TOTAL).fill(-1);
                score = 0;
                quizCompleted = false;
                prevBtn.style.display = 'inline-flex';
                skipBtn.style.display = 'inline-flex';
                nextBtn.style.display = 'inline-flex';
                nextBtn.textContent = 'Next Question ▶';
                nextBtn.disabled = true;
                prevBtn.disabled = true;
                skipBtn.style.display = 'inline-flex';
                scoreDisplay.textContent = 'Score: 0';
                progressBar.style.width = '0%';
                progressLabel.textContent = `Question 1 of ${TOTAL}`;
                renderQuestion();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            // ==================== EVENT LISTENERS ====================
            nextBtn.addEventListener('click', goToNext);
            prevBtn.addEventListener('click', goToPrev);
            skipBtn.addEventListener('click', handleSkip);

            // Keyboard navigation
            document.addEventListener('keydown', function(e) {
                if (quizCompleted) return;
                if (e.key === 'ArrowRight' && !nextBtn.disabled) {
                    e.preventDefault();
                    goToNext();
                } else if (e.key === 'ArrowLeft' && !prevBtn.disabled) {
                    e.preventDefault();
                    goToPrev();
                } else if (e.key === 's' && skipBtn.style.display !== 'none' && !e.ctrlKey && !e.metaKey && !e
                    .altKey) {
                    e.preventDefault();
                    handleSkip();
                }
            });

            // ==================== INITIAL RENDER ====================
            renderQuestion();
            prevBtn.disabled = true;
            nextBtn.disabled = true;
        })();
    </script>
</body>
</html>