    [108,'Hs','Hassium',269,'8','transition',7,8],
    [109,'Mt','Meitnerium',278,'-','unknown',7,9],
    [110,'Ds','Darmstadtium',281,'-','unknown',7,10],
    [111,'Rg','Roentgenium',282,'-','unknown',7,11],
    [112,'Cn','Copernicium',285,'2','transition',7,12],
    [113,'Nh','Nihonium',286,'1,3','posttrans',7,13],
    [114,'Fl','Flerovium',289,'2,4','posttrans',7,14],
    [115,'Mc','Moscovium',290,'1,3','posttrans',7,15],
    [116,'Lv','Livermorium',293,'2,4','posttrans',7,16],
    [117,'Ts','Tennessine',294,'1','halogen',7,17],
    [118,'Og','Oganesson',294,'0','noble',7,18]
  ];

  const CATS = [
    ['alkali','Alkali Metal'],
    ['alkaline','Alkaline Earth'],
    ['transition','Transition Metal'],
    ['lanthanide','Lanthanide'],
    ['actinide','Actinide'],
    ['posttrans','Post-Transition'],
    ['metalloid','Metalloid'],
    ['nonmetal','Reactive Nonmetal'],
    ['halogen','Halogen'],
    ['noble','Noble Gas'],
    ['unknown','Unknown']
  ];

  const mainTable   = document.getElementById('mainTable');
  const fBlockTable = document.getElementById('fBlockTable');
  const legend      = document.getElementById('legend');

  // ---- legend banate hain ----
  CATS.forEach(([key, label]) => {
    const item = document.createElement('div');
    item.className = 'legend-item cat-' + key;
    item.innerHTML = '<span class="dot"></span>' + label;
    legend.appendChild(item);
  });

  // ---- 118 element-boxes generate karte hain data se ----
  ELEMENTS.forEach(d => {
    const [num, sym, name, wt, val, cat, row, col] = d;
    const isMain   = row <= 7;
    const gridRow  = isMain ? row : row - 8; // f-block ke apne 2 rows (9,10 -> 1,2)

    const a = document.createElement('a');
    a.href = sym;                              // <-- routing ke liye khud element ka sanket
    a.className = 'element-box cat-' + cat;
    a.style.gridColumn = col;
    a.style.gridRow = gridRow;
    a.setAttribute('aria-label', name + ', atomic number ' + num);
    a.title = name + ' (' + sym + ')  |  Atomic No: ' + num + '  |  Atomic Weight: ' + wt + ' g/mol  |  Valency: ' + val;

    if (isMain && (col === 3 || col === 13)) a.classList.add('block-start');

    a.innerHTML =
      '<span class="box-left">' +
        '<span class="symbol">' + sym + '</span>' +
        '<span class="ename">' + name + '</span>' +
      '</span>' +
      '<span class="box-right">' +
        '<span class="num">' + num + '</span>' +
        '<span class="wt">' + wt + '</span>' +
        '<span class="val">V:' + val + '</span>' +
      '</span>';

    (isMain ? mainTable : fBlockTable).appendChild(a);
  });

  // ---- lanthanide / actinide series ke placeholder box (main table mein) ----
  function addPlaceholder(row, col, big, small) {
    const div = document.createElement('div');
    div.className = 'placeholder-box block-start';
    div.style.gridColumn = col;
    div.style.gridRow = row;
    div.title = small + ' series';
    div.innerHTML = '<span class="ph-num">' + big + '</span><span class="ph-label">' + small + '</span>';
    mainTable.appendChild(div);
  }
  addPlaceholder(6, 3, '57-71', 'La \u2013 Lu');
  addPlaceholder(7, 3, '89-103', 'Ac \u2013 Lr');
</script>

