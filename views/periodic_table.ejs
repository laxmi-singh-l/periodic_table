<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Periodic Table</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>

  /* =====================================================================
     GAP CONTROLS — sirf inhi 2 values ko change karke poori table ki
     spacing turant badal sakte ho. Baaki sab CSS neeche isi par depend
     karta hai, isliye inhe hamesha yahi sabse upar rakha hai.
     ===================================================================== */
  :root{
    --element-gap: 6px;   /* har element-box ke beech ka MINIMUM gap */
    --block-gap:   18px;   /* s/d/p/f block ke beech ka MINIMUM gap (group 2→3, 12→13, aur f-block se pehle) */
  }
  /* ===================================================================== */

  :root{
    --box-w: 96px;
    --box-h: 84px;

    --bg-1:#1a1030;
    --bg-2:#0a0714;
    --bg-3:#050308;
    --text:#EDEEFA;
    --text-dim:#9296B8;

    /* category ke neon rang — same category = same rang, guaranteed */
    --alkali:#FF3D6E;      --alkali-rgb:255,61,110;
    --alkaline:#FA8B29;    --alkaline-rgb:250,139,41;
    --lanthanide:#F9CF29;  --lanthanide-rgb:249,207,41;
    --actinide:#A6E62E;    --actinide-rgb:166,230,46;
    --transition:#29E693;  --transition-rgb:41,230,147;
    --posttrans:#1FDDC4;   --posttrans-rgb:31,221,196;
    --metalloid:#29C4F2;   --metalloid-rgb:41,196,242;
    --nonmetal:#4A80F5;    --nonmetal-rgb:74,128,245;
    --halogen:#8452F0;     --halogen-rgb:132,82,240;
    --noble:#EE41D6;       --noble-rgb:238,65,214;
    --unknown:#A3A6C2;     --unknown-rgb:163,166,194;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background: radial-gradient(ellipse 1300px 800px at 50% -8%, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);
    color:var(--text);
    font-family:'Space Grotesk',sans-serif;
    -webkit-font-smoothing:antialiased;
    padding:36px 16px 60px;
    position:relative;
  }
  body::before{
    content:'';
    position:fixed;
    inset:0;
    background-image:radial-gradient(rgba(255,255,255,.045) 1px, transparent 1px);
    background-size:28px 28px;
    pointer-events:none;
    z-index:0;
  }
  .container{position:relative;z-index:1;max-width:1800px;margin:0 auto;}

  header{text-align:center;margin-bottom:20px;}
  .neon-title{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(30px,6vw,52px);
    letter-spacing:6px;
    margin:0;
    color:#fff;
    text-shadow:0 0 6px #fff, 0 0 22px #29C4F2, 0 0 46px #8452F0, 0 0 90px rgba(132,82,240,.5);
    animation:flicker 5s ease-in-out infinite;
  }
  @keyframes flicker{
    0%,17%,19%,21%,52%,54%,100%{opacity:1;}
    18%,20%,53%{opacity:.82;}
  }
  .stat-line{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    letter-spacing:3px;
    color:var(--text-dim);
    margin:10px 0 4px;
    text-transform:uppercase;
  }
  .subtitle{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    color:var(--text-dim);
    margin:0;
    letter-spacing:.4px;
  }

  .legend{
    display:flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;
    margin:24px auto 26px;max-width:1100px;
  }
  .legend-item{
    display:flex;align-items:center;gap:6px;
    font-family:'JetBrains Mono',monospace;
    font-size:11px;color:var(--text-dim);
    letter-spacing:.3px;
  }
  .legend-item .dot{
    width:9px;height:9px;border-radius:50%;
    background:var(--cat);
    box-shadow:0 0 6px var(--cat),0 0 12px var(--cat);
    flex-shrink:0;
  }

  .table-scroll{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;  /* smooth momentum-scroll on Android/iOS */
    padding-bottom:16px;
    scrollbar-width:thin;
    scrollbar-color:#8452F0 #0a0714;
  }
  .table-scroll::-webkit-scrollbar{height:10px;}
  .table-scroll::-webkit-scrollbar-track{background:#0a0714;border-radius:10px;}
  .table-scroll::-webkit-scrollbar-thumb{background:linear-gradient(90deg,#EE41D6,#29C4F2);border-radius:10px;}

  /* IMPORTANT: centering yahan margin:auto se hoti hai, flexbox/grid ke
     align-items:center se NAHI. Jab content chhoti screen par overflow
     karta hai to margin:auto khud 0 ban jaata hai aur table left se
     shuru hoti hai — isliye s-block (group 1-2) scroll karke hamesha
     milega. align-items:center use karne par overflow ka "start" hissa
     (yahan s-block) scroll se kabhi reach nahi hota — ye ek common
     CSS gotcha hai, isse bachna hai. */
  .periodic-table, .f-block{
    display:grid;
    grid-template-columns:repeat(18,minmax(var(--box-w),1fr));
    grid-auto-rows:var(--box-h);
    gap:var(--element-gap);
    width:max-content;
    margin:0 auto;
  }
  .f-block{margin-top:var(--block-gap);}

  /* ---- category colour classes: same category -> same --cat/--cat-rgb ---- */
  .cat-alkali{--cat:var(--alkali);--cat-rgb:var(--alkali-rgb);}
  .cat-alkaline{--cat:var(--alkaline);--cat-rgb:var(--alkaline-rgb);}
  .cat-transition{--cat:var(--transition);--cat-rgb:var(--transition-rgb);}
  .cat-lanthanide{--cat:var(--lanthanide);--cat-rgb:var(--lanthanide-rgb);}
  .cat-actinide{--cat:var(--actinide);--cat-rgb:var(--actinide-rgb);}
  .cat-posttrans{--cat:var(--posttrans);--cat-rgb:var(--posttrans-rgb);}
  .cat-metalloid{--cat:var(--metalloid);--cat-rgb:var(--metalloid-rgb);}
  .cat-nonmetal{--cat:var(--nonmetal);--cat-rgb:var(--nonmetal-rgb);}
  .cat-halogen{--cat:var(--halogen);--cat-rgb:var(--halogen-rgb);}
  .cat-noble{--cat:var(--noble);--cat-rgb:var(--noble-rgb);}
  .cat-unknown{--cat:var(--unknown);--cat-rgb:var(--unknown-rgb);}

  .element-box{
    text-decoration:none;
    display:flex;align-items:center;justify-content:space-between;
    padding:6px 7px;
    border-radius:11px;
    border:1px solid var(--cat);
    background:rgba(var(--cat-rgb),.10);
    box-shadow:0 0 5px rgba(var(--cat-rgb),.5), inset 0 0 8px rgba(var(--cat-rgb),.12);
    position:relative;
    overflow:hidden;
    cursor:pointer;
    -webkit-tap-highlight-color:transparent;
    transition:transform .32s cubic-bezier(.34,1.56,.64,1), box-shadow .32s ease, background .32s ease;
  }
  /* block-start = jahan se ek naya block (d-block ya p-block) shuru hota hai */
  .element-box.block-start,
  .placeholder-box.block-start{margin-left:var(--block-gap);}

  .element-box:hover{
    transform:translateY(-6px) scale(1.16);
    z-index:30;
    background:rgba(var(--cat-rgb),.22);
    box-shadow:0 0 14px rgba(var(--cat-rgb),.9), 0 0 34px rgba(var(--cat-rgb),.5), 0 12px 22px rgba(0,0,0,.5);
  }
  .element-box:active{transform:translateY(-2px) scale(1.05);}

  /* shine-sweep: hover par ek neon light box ke upar se guzarti hai */
  .element-box::after{
    content:'';
    position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,.35),transparent);
    transform:skewX(-20deg);
    transition:left .6s ease;
    pointer-events:none;
  }
  .element-box:hover::after{left:120%;}

  .box-left{display:flex;flex-direction:column;overflow:hidden;max-width:54px;}
  .symbol{
    font-family:'Space Grotesk',sans-serif;font-weight:700;
    font-size:24px;line-height:1;
    color:var(--cat);
    text-shadow:0 0 8px rgba(var(--cat-rgb),.85);
  }
  .ename{
    font-family:'Space Grotesk',sans-serif;font-weight:500;
    font-size:8px;text-transform:uppercase;letter-spacing:.4px;
    color:#D6D6F2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    margin-top:3px;
  }
  .box-right{
    display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;
    font-family:'JetBrains Mono',monospace;line-height:1.35;
    margin-left:4px;
  }
  .box-right .num{font-size:11px;font-weight:700;color:#fff;}
  .box-right .wt{font-size:7.5px;font-weight:500;color:rgba(255,255,255,.7);}
  .box-right .val{font-size:7.5px;font-weight:500;color:rgba(255,255,255,.7);}

  .placeholder-box{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    border:1.5px dashed rgba(255,255,255,.32);
    border-radius:11px;
    background:linear-gradient(135deg,rgba(249,207,41,.10),rgba(166,230,46,.10));
  }
  .placeholder-box .ph-num{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:#fff;}
  .placeholder-box .ph-label{font-family:'Space Grotesk',sans-serif;font-size:9px;color:#9296B8;margin-top:3px;letter-spacing:.3px;}

  footer{
    text-align:center;margin-top:26px;
    font-family:'JetBrains Mono',monospace;font-size:10.5px;
    color:var(--text-dim);letter-spacing:.4px;
  }

  .scroll-hint{
    display:none; /* sirf mobile par dikhega, neeche media query me on hota hai */
    text-align:center;
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    color:var(--text-dim);
    margin:2px 0 14px;
    animation:hint-pulse 2s ease-in-out infinite;
  }
  @keyframes hint-pulse{0%,100%{opacity:.45;}50%{opacity:1;}}

  /* ===================== ANDROID / MOBILE BREAKPOINTS ===================== */
  @media (max-width:768px){
    body{padding:26px 10px 50px;}
    .neon-title{letter-spacing:3px;}
    .stat-line{letter-spacing:2px;font-size:10.5px;}
    .subtitle{font-size:10.5px;padding:0 6px;}
    .legend{gap:6px 12px;margin:16px auto 6px;}
    .legend-item{font-size:10px;}
    .scroll-hint{display:block;}
  }

  @media (max-width:480px){
    :root{
      --box-w:78px;   /* chhote phone par box thoda chhota, scroll kam karna pade */
      --box-h:74px;
    }
    .symbol{font-size:20px;}
    .ename{font-size:7px;max-width:44px;}
    .box-left{max-width:44px;}
    .box-right .num{font-size:9.5px;}
    .box-right .wt,.box-right .val{font-size:6.5px;}
    .neon-title{font-size:26px;}
  }
  /* =========================================================================== */

  /* ========== TOP-LEFT BACK BUTTON (NEON THEME) ========== */
  .back-home-btn {
    position: fixed;
    top: 25px;
    left: 25px;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: rgba(10, 10, 10, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid #00ffff;
    border-radius: 30px;
    color: #00ffff;
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.4), 0 4px 15px rgba(0, 0, 0, 0.5);
  }
  .back-home-btn:hover {
    background: rgba(0, 255, 255, 0.1);
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.7), 0 0 15px rgba(0, 255, 255, 0.4) inset;
    color: #ffffff;
    border-color: #ffffff;
    transform: translateY(-2px);
  }
  .back-home-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }
  @media (max-width: 600px) {
    .back-home-btn {
      top: 15px;
      left: 15px;
      padding: 8px 16px;
      font-size: 0.75rem;
    }
    .back-home-btn svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
<!-- Essential SEO Meta Tags -->
<% 
  const pageTitle = typeof title !== 'undefined' ? title : 'My Website';
  const pageDesc = typeof description !== 'undefined' ? description : 'Welcome to our website';
%>
<title><%= pageTitle %></title>
<meta name="title" content="<%= pageTitle %>">
<meta name="description" content="<%= pageDesc %>">
<meta name="robots" content="index, follow">

<!-- Open Graph / WhatsApp Preview -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<% if (typeof url !== 'undefined') { %><meta property="og:url" content="<%= url %>"><% } %>
<% if (typeof image !== 'undefined') { %><meta property="og:image" content="<%= image %>"><% } %>

<!-- Twitter Card -->
<meta property="twitter:card" content="summary">
<meta property="twitter:title" content="<%= pageTitle %>">
<meta property="twitter:description" content="<%= pageDesc %>">
<% if (typeof url !== 'undefined') { %><meta property="twitter:url" content="<%= url %>"><% } %>
<% if (typeof image !== 'undefined') { %><meta property="twitter:image" content="<%= image %>"><% } %>

