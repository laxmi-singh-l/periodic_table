    <section class="hero">
        <h1>Cookie Policy</h1>
        <p class="subtitle">ePrivacy Directive & GDPR Compliant</p>
    </section>

    <div class="container">
        <div class="policy-card">

            <p class="last-updated">📅 Last Updated: <strong>August 05, 2026</strong></p>

            <h2>1. What Are Cookies?</h2>
            <p>
                Cookies are small text files stored on your device (computer, tablet, or mobile) when you visit a website. They help websites remember your preferences, improve performance, and provide a better user experience. Cookies may be <strong>session cookies</strong> (deleted when you close your browser) or <strong>persistent cookies</strong> (remain until they expire or you delete them).
            </p>

            <h2>2. How We Use Cookies</h2>
            <p>
                Periodic Instructor uses cookies for the following purposes:
            </p>
            <ul>
                <li><strong>Essential/Necessary Cookies:</strong> Required for the website to function properly.</li>
                <li><strong>Analytics/Performance Cookies:</strong> To understand how visitors interact with our website (via Google Analytics).</li>
                <li><strong>Functional Cookies:</strong> To remember your preferences and enhance your experience.</li>
            </ul>

            <h2>3. Cookies We Use</h2>

            <table class="cookie-table">
                <thead>
                    <tr>
                        <th>Cookie Name</th>
                        <th>Type</th>
                        <th>Purpose</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>cookie_consent</strong></td>
                        <td>Essential</td>
                        <td>Stores your cookie consent preferences</td>
                        <td>6 months</td>
                    </tr>
                    <tr>
                        <td><strong>_ga</strong></td>
                        <td>Analytics</td>
                        <td>Google Analytics – distinguishes users</td>
                        <td>2 years</td>
                    </tr>
                    <tr>
                        <td><strong>_ga_*</strong></td>
                        <td>Analytics</td>
                        <td>Google Analytics – persists session state</td>
                        <td>2 years</td>
                    </tr>
                    <tr>
                        <td><strong>_gid</strong></td>
                        <td>Analytics</td>
                        <td>Google Analytics – distinguishes users</td>
                        <td>24 hours</td>
                    </tr>
                    <tr>
                        <td><strong>_gat</strong></td>
                        <td>Analytics</td>
                        <td>Google Analytics – throttles request rate</td>
                        <td>1 minute</td>
                    </tr>
                    <tr>
                        <td><strong>preferred_theme</strong></td>
                        <td>Functional</td>
                        <td>Remembers light/dark mode preference</td>
                        <td>1 year</td>
                    </tr>
                </tbody>
            </table>

            <h2>4. Third-Party Cookies</h2>
            <p>
                We use <strong>Google Analytics</strong>, a web analytics service provided by Google Inc. Google Analytics uses cookies to help us analyse how users use our site. The information generated by the cookie about your use of the website (including your IP address) is transmitted to and stored by Google on servers in the United States.
            </p>
            <p>
                Google may transfer this information to third parties where required by law or where third parties process the information on Google's behalf. Learn more: <a href="https://policies.google.com/privacy" target="_blank">Google Privacy Policy</a>.
            </p>
            <p>
                <strong>Opt-out of Google Analytics:</strong> Install the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank">Google Analytics Opt-out Browser Add-on</a>.
            </p>

            <h2>5. Cookie Consent & Control</h2>
            <p>
                When you first visit our website, a <strong>cookie consent banner</strong> will appear asking for your consent to non-essential cookies (as required by the ePrivacy Directive and GDPR). You have the following options:
            </p>
            <ul>
                <li><strong>Accept All:</strong> Consent to all cookies.</li>
                <li><strong>Reject Non-Essential:</strong> Only necessary cookies will be set.</li>
                <li><strong>Customise:</strong> Choose specific cookie categories.</li>
            </ul>

            <h2>6. Managing Cookies Through Browser Settings</h2>
            <p>
                You can also control and delete cookies through your browser settings. Instructions for popular browsers:
            </p>
            <ul>
                <li><a href="https://support.google.com/chrome/answer/95647" target="_blank">Google Chrome</a></li>
                <li><a href="https://support.mozilla.org/en-US/kb/clear-cookies-and-site-data-firefox" target="_blank">Mozilla Firefox</a></li>
                <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" target="_blank">Apple Safari</a></li>
                <li><a href="https://support.microsoft.com/en-us/windows/manage-cookies-in-microsoft-edge" target="_blank">Microsoft Edge</a></li>
            </ul>
            <p>
                <strong>Note:</strong> Disabling certain cookies may affect the functionality of our website.
            </p>

            <h2>7. Changes to This Cookie Policy</h2>
            <p>
                We may update this Cookie Policy from time to time. Changes will be posted on this page with an updated "Last Updated" date. Continued use of the website after changes indicates acceptance.
            </p>

            <div class="contact-box">
                <h3>📧 Questions About Our Cookie Policy?</h3>
                <p>
                    If you have any questions, please contact us:<br>
                    <strong>Email:</strong> <a href="mailto:a.s.r2innovation@gmail.com">a.s.r2innovation@gmail.com</a>
                </p>
            </div>

        </div>
    </div>

    <footer class="footer">
        &copy; <span id="year"></span> <span>Periodic Instructor</span> – ASR Group. All rights reserved. |
        <a href="/">Privacy Policy</a> | <a href="/terms">Terms</a> 
    </footer>

    <!-- Cookie Consent Banner -->
    <div id="cookie-consent-banner" style="
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #1a2a3a;
        color: #ffffff;
        padding: 20px 30px;
        z-index: 9999;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.95rem;
        line-height: 1.5;
        transform: translateY(100%);
        transition: transform 0.4s ease-in-out;
    ">
        <div style="flex: 1; min-width: 250px;">
            <strong style="font-size: 1.1rem;">🍪 We Use Cookies</strong>
            <p style="margin: 5px 0 0; color: #b0bec5;">
                We use cookies to enhance your learning experience, analyse traffic, and personalise content. 
                By clicking "Accept All", you consent to our use of cookies. 
                <a href="cookie-policy.html" style="color: #3498db; text-decoration: underline;">Learn more</a>
            </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
            <button id="cookie-reject-all" style="
                background: transparent;
                color: #b0bec5;
                border: 2px solid #b0bec5;
                padding: 10px 20px;
                border-radius: 30px;
                cursor: pointer;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s;
            " onmouseover="this.style.borderColor='#ffffff'; this.style.color='#ffffff';" 
               onmouseout="this.style.borderColor='#b0bec5'; this.style.color='#b0bec5';">
                Reject All
            </button>
            <button id="cookie-customise" style="
                background: transparent;
                color: #b0bec5;
                border: 2px solid #b0bec5;
                padding: 10px 20px;
                border-radius: 30px;
                cursor: pointer;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s;
            " onmouseover="this.style.borderColor='#ffffff'; this.style.color='#ffffff';" 
               onmouseout="this.style.borderColor='#b0bec5'; this.style.color='#b0bec5';">
                Customise
            </button>
            <button id="cookie-accept-all" style="
                background: #3498db;
                color: #ffffff;
                border: 2px solid #3498db;
                padding: 10px 20px;
                border-radius: 30px;
                cursor: pointer;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s;
            " onmouseover="this.style.background='#2980b9'; this.style.borderColor='#2980b9';" 
               onmouseout="this.style.background='#3498db'; this.style.borderColor='#3498db';">
                Accept All
            </button>
        </div>
    </div>

    <!-- Cookie Preferences Modal -->
    <div id="cookie-preferences-modal" style="
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.6);
        z-index: 10000;
        justify-content: center;
        align-items: center;
        padding: 20px;
    ">
        <div style="
            background: #ffffff;
            border-radius: 16px;
            padding: 35px 30px;
            max-width: 550px;
            width: 100%;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            color: #2c3e50;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        ">
            <h2 style="margin-top: 0; color: #1a2a3a; font-size: 1.5rem;">Cookie Preferences</h2>
            <p style="color: #5a6a7e; font-size: 0.9rem; margin-bottom: 20px;">
                Choose which cookies you want to allow. Essential cookies cannot be disabled.
            </p>

            <div style="margin-bottom: 15px; padding: 15px; background: #f4f6f9; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong>Essential Cookies</strong>
                    <p style="margin: 3px 0 0; font-size: 0.85rem; color: #7f8c8d;">Required for the website to function properly. Always enabled.</p>
                </div>
                <input type="checkbox" checked disabled style="accent-color: #3498db; width: 18px; height: 18px;">
            </div>

            <div style="margin-bottom: 15px; padding: 15px; background: #f4f6f9; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong>Analytics Cookies</strong>
                    <p style="margin: 3px 0 0; font-size: 0.85rem; color: #7f8c8d;">Help us understand how visitors interact with our content.</p>
                </div>
                <input type="checkbox" id="analytics-cookies-checkbox" checked style="accent-color: #3498db; width: 18px; height: 18px;">
            </div>

            <div style="margin-bottom: 20px; padding: 15px; background: #f4f6f9; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong>Functional Cookies</strong>
                    <p style="margin: 3px 0 0; font-size: 0.85rem; color: #7f8c8d;">Remember your preferences like theme settings.</p>
                </div>
                <input type="checkbox" id="functional-cookies-checkbox" checked style="accent-color: #3498db; width: 18px; height: 18px;">
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button id="modal-cancel" style="
                    background: transparent;
                    color: #2c3e50;
                    border: 2px solid #ccc;
                    padding: 10px 20px;
                    border-radius: 30px;
                    cursor: pointer;
                    font-weight: 600;
                ">Cancel</button>
                <button id="modal-save" style="
                    background: #3498db;
                    color: #fff;
                    border: none;
                    padding: 10px 25px;
                    border-radius: 30px;
                    cursor: pointer;
                    font-weight: 600;
                ">Save Preferences</button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            const banner = document.getElementById('cookie-consent-banner');
            const modal = document.getElementById('cookie-preferences-modal');
            const acceptAllBtn = document.getElementById('cookie-accept-all');
            const rejectAllBtn = document.getElementById('cookie-reject-all');
            const customiseBtn = document.getElementById('cookie-customise');
            const modalCancel = document.getElementById('modal-cancel');
            const modalSave = document.getElementById('modal-save');
            const analyticsCheckbox = document.getElementById('analytics-cookies-checkbox');
            const functionalCheckbox = document.getElementById('functional-cookies-checkbox');

            const consentData = localStorage.getItem('periodic_instructor_cookie_consent');

            if (!consentData) {
                setTimeout(() => {
                    banner.style.transform = 'translateY(0)';
                }, 500);
            } else {
                banner.style.display = 'none';
                applyConsent(JSON.parse(consentData));
            }

            acceptAllBtn.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: true,
                    functional: true,
                    timestamp: new Date().toISOString()
                };
                saveConsent(consent);
            });

            rejectAllBtn.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: false,
                    functional: false,
                    timestamp: new Date().toISOString()
                };
                saveConsent(consent);
            });

            customiseBtn.addEventListener('click', () => {
                const existing = localStorage.getItem('periodic_instructor_cookie_consent');
                if (existing) {
                    const parsed = JSON.parse(existing);
                    analyticsCheckbox.checked = parsed.analytics !== false;
                    functionalCheckbox.checked = parsed.functional !== false;
                }
                modal.style.display = 'flex';
            });

            modalCancel.addEventListener('click', () => {
                modal.style.display = 'none';
            });

            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.style.display = 'none';
                }
            });

            modalSave.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: analyticsCheckbox.checked,
                    functional: functionalCheckbox.checked,
                    timestamp: new Date().toISOString()
                };
                modal.style.display = 'none';
                saveConsent(consent);
            });

            function saveConsent(consent) {
                localStorage.setItem('periodic_instructor_cookie_consent', JSON.stringify(consent));
                banner.style.transform = 'translateY(100%)';
                setTimeout(() => {
                    banner.style.display = 'none';
                }, 400);
                applyConsent(consent);
            }

            function applyConsent(consent) {
                if (consent.analytics) {
                    console.log('✅ Analytics cookies enabled');
                    enableGoogleAnalytics();
                } else {
                    console.log('❌ Analytics cookies disabled');
                    disableGoogleAnalytics();
                }

                if (consent.functional) {
                    console.log('✅ Functional cookies enabled');
                    enableFunctionalCookies();
                } else {
                    console.log('❌ Functional cookies disabled');
                    disableFunctionalCookies();
                }
            }

            function enableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') {
                    gtag('consent', 'update', {
                        'analytics_storage': 'granted'
                    });
                }
            }

            function disableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') {
                    gtag('consent', 'update', {
                        'analytics_storage': 'denied'
                    });
                }
                document.cookie.split(';').forEach(c => {
                    if (c.trim().startsWith('_ga') || c.trim().startsWith('_gid') || c.trim().startsWith('_gat')) {
                        document.cookie = c.trim().split('=')[0] + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    }
                });
            }

            function enableFunctionalCookies() {
                const theme = localStorage.getItem('preferred_theme');
                if (theme) {
                    document.body.className = theme;
                }
            }

            function disableFunctionalCookies() {
                localStorage.removeItem('preferred_theme');
            }

        })();
    </script>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>

</body>
</html>