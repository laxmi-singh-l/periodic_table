                    <strong>Functional Cookies</strong>
                    <p style="margin: 3px 0 0; font-size: 0.85rem; color: #7f8c8d;">Remember your preferences like theme settings.</p>
                </div>
                <input type="checkbox" id="functional-cookies-checkbox" checked style="accent-color: #3498db; width: 18px; height: 18px;">
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button id="modal-cancel" style="
                    background: transparent;
                    color: #2c3e50;
                    border: 2px solid #ccc;
                    padding: 10px 20px;
                    border-radius: 30px;
                    cursor: pointer;
                    font-weight: 600;
                ">Cancel</button>
                <button id="modal-save" style="
                    background: #3498db;
                    color: #fff;
                    border: none;
                    padding: 10px 25px;
                    border-radius: 30px;
                    cursor: pointer;
                    font-weight: 600;
                ">Save Preferences</button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            const banner = document.getElementById('cookie-consent-banner');
            const modal = document.getElementById('cookie-preferences-modal');
            const acceptAllBtn = document.getElementById('cookie-accept-all');
            const rejectAllBtn = document.getElementById('cookie-reject-all');
            const customiseBtn = document.getElementById('cookie-customise');
            const modalCancel = document.getElementById('modal-cancel');
            const modalSave = document.getElementById('modal-save');
            const analyticsCheckbox = document.getElementById('analytics-cookies-checkbox');
            const functionalCheckbox = document.getElementById('functional-cookies-checkbox');

            const consentData = localStorage.getItem('periodic_instructor_cookie_consent');

            if (!consentData) {
                setTimeout(() => {
                    banner.style.transform = 'translateY(0)';
                }, 500);
            } else {
                banner.style.display = 'none';
                applyConsent(JSON.parse(consentData));
            }

            acceptAllBtn.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: true,
                    functional: true,
                    timestamp: new Date().toISOString()
                };
                saveConsent(consent);
            });

            rejectAllBtn.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: false,
                    functional: false,
                    timestamp: new Date().toISOString()
                };
                saveConsent(consent);
            });

            customiseBtn.addEventListener('click', () => {
                const existing = localStorage.getItem('periodic_instructor_cookie_consent');
                if (existing) {
                    const parsed = JSON.parse(existing);
                    analyticsCheckbox.checked = parsed.analytics !== false;
                    functionalCheckbox.checked = parsed.functional !== false;
                }
                modal.style.display = 'flex';
            });

            modalCancel.addEventListener('click', () => {
                modal.style.display = 'none';
            });

            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.style.display = 'none';
                }
            });

            modalSave.addEventListener('click', () => {
                const consent = {
                    essential: true,
                    analytics: analyticsCheckbox.checked,
                    functional: functionalCheckbox.checked,
                    timestamp: new Date().toISOString()
                };
                modal.style.display = 'none';
                saveConsent(consent);
            });

            function saveConsent(consent) {
                localStorage.setItem('periodic_instructor_cookie_consent', JSON.stringify(consent));
                banner.style.transform = 'translateY(100%)';
                setTimeout(() => {
                    banner.style.display = 'none';
                }, 400);
                applyConsent(consent);
            }

            function applyConsent(consent) {
                if (consent.analytics) {
                    console.log('✅ Analytics cookies enabled');
                    enableGoogleAnalytics();
                } else {
                    console.log('❌ Analytics cookies disabled');
                    disableGoogleAnalytics();
                }

                if (consent.functional) {
                    console.log('✅ Functional cookies enabled');
                    enableFunctionalCookies();
                } else {
                    console.log('❌ Functional cookies disabled');
                    disableFunctionalCookies();
                }
            }

            function enableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') {
                    gtag('consent', 'update', {
                        'analytics_storage': 'granted'
                    });
                }
            }

            function disableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') {
                    gtag('consent', 'update', {
                        'analytics_storage': 'denied'
                    });
                }
                document.cookie.split(';').forEach(c => {
                    if (c.trim().startsWith('_ga') || c.trim().startsWith('_gid') || c.trim().startsWith('_gat')) {
                        document.cookie = c.trim().split('=')[0] + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    }
                });
            }

            function enableFunctionalCookies() {
                const theme = localStorage.getItem('preferred_theme');
                if (theme) {
                    document.body.className = theme;
                }
            }

            function disableFunctionalCookies() {
                localStorage.removeItem('preferred_theme');
            }

        })();
    </script>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>

