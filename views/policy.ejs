    <style>
        /* ========== ORIGINAL FULL CSS (NO LINES REMOVED) ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ========== LIGHT THEME (default) ========== */
        :root {
            --bg-page: #f8fafc;
            --bg-card: #ffffff;
            --text-primary: #1e293b;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --border-light: #e2e8f0;
            --accent-blue: #2563eb;
            --accent-blue-hover: #1d4ed8;
            --nav-bg: #1a2a3a;
            --nav-text: #cbd5e1;
            --nav-hover: #60a5fa;
            --hero-bg-start: #0f172a;
            --hero-bg-end: #1a2a3a;
            --hero-text: #ffffff;
            --hero-sub: #93c5fd;
            --accept-bg: #eff6ff;
            --accept-border: #93c5fd;
            --btn-disabled-bg: #94a3b8;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.1);
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --transition: 0.25s ease;
            --attention-bg: #f0f9ff;
            --attention-border: #bae6fd;
            --attention-text: #075985;
            --attention-icon: #0284c7;
            --cookie-banner-bg: #0f172a;
            --cookie-banner-text: #f1f5f9;
            --modal-bg: #ffffff;
            --cookie-option-bg: #f8fafc;
        }

        /* ========== DARK THEME ========== */
        body.dark {
            --bg-page: #0f172a;
            --bg-card: #1e293b;
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --border-light: #334155;
            --accent-blue: #3b82f6;
            --accent-blue-hover: #2563eb;
            --nav-bg: #0b1120;
            --nav-text: #94a3b8;
            --nav-hover: #60a5fa;
            --hero-bg-start: #020617;
            --hero-bg-end: #0f172a;
            --hero-text: #f8fafc;
            --hero-sub: #93c5fd;
            --accept-bg: #1e293b;
            --accept-border: #3b82f6;
            --btn-disabled-bg: #475569;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.4);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.5);
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.6);
            --attention-bg: #1e293b;
            --attention-border: #334155;
            --attention-text: #bae6fd;
            --attention-icon: #38bdf8;
            --cookie-banner-bg: #020617;
            --cookie-banner-text: #cbd5e1;
            --modal-bg: #1e293b;
            --cookie-option-bg: #0f172a;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-primary);
            line-height: 1.7;
            transition: background-color 0.3s, color 0.3s;
            -webkit-font-smoothing: antialiased;
        }

        /* ========== ATTENTION NOTE BOX ========== */
        .attention-note {
            background: var(--attention-bg);
            border: 2px solid var(--attention-border);
            border-radius: var(--radius-md);
            padding: 16px 24px;
            margin: 20px auto;
            max-width: 920px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            color: var(--attention-text);
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: var(--shadow-sm);
            line-height: 1.6;
            transition: background-color 0.3s, border-color 0.3s, color 0.3s;
        }
        .attention-note .note-icon {
            font-size: 1.5rem;
            color: var(--attention-icon);
            flex-shrink: 0;
            margin-top: 2px;
        }
        .attention-note strong {
            color: var(--attention-icon);
        }

        /* ========== NAVBAR ========== */
        .navbar {
            background-color: var(--nav-bg);
            padding: 16px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: 100;
            transition: background-color 0.3s;
        }
        .navbar .logo {
            font-size: 1.7rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.4px;
            text-decoration: none;
            white-space: nowrap;
        }
        .navbar .logo span {
            color: #60a5fa;
        }
        .navbar .tagline {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 400;
        }
        .nav-links {
            display: flex;
            gap: 22px;
            list-style: none;
            flex-wrap: wrap;
            align-items: center;
        }
        .nav-links a,
        .nav-links button {
            color: var(--nav-text);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color var(--transition);
            white-space: nowrap;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px 0;
        }
        .nav-links a:hover,
        .nav-links button:hover {
            color: var(--nav-hover);
        }
        .theme-toggle {
            background: transparent;
            border: 2px solid #475569;
            border-radius: 50px;
            padding: 6px 14px;
            color: #cbd5e1;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .theme-toggle:hover {
            border-color: #60a5fa;
            color: #60a5fa;
        }

        /* ========== HERO ========== */
        .hero {
            background: linear-gradient(135deg, var(--hero-bg-start) 0%, var(--hero-bg-end) 100%);
            color: var(--hero-text);
            text-align: center;
            padding: 55px 20px 50px;
            transition: background 0.3s;
        }
        .hero h1 {
            font-size: clamp(1.8rem, 4vw, 2.6rem);
            font-weight: 700;
            margin-bottom: 8px;
        }
        .hero .subtitle {
            font-size: 1rem;
            color: var(--hero-sub);
            font-weight: 300;
        }

        /* ========== CONTAINER ========== */
        .container {
            max-width: 920px;
            margin: 0 auto;
            padding: 40px 20px 50px;
        }

        /* ========== POLICY CARD ========== */
        .policy-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 38px 32px;
            box-shadow: var(--shadow-lg);
            margin-bottom: 30px;
            border: 1px solid var(--border-light);
            transition: background-color 0.3s, border-color 0.3s;
        }

        /* ========== ACCEPTANCE BOX ========== */
        .acceptance-box {
            background: var(--accept-bg);
            border: 2px solid var(--accept-border);
            border-radius: var(--radius-lg);
            padding: 22px 28px;
            margin-bottom: 28px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            box-shadow: var(--shadow-sm);
            transition: background-color 0.3s, border-color 0.3s;
        }
        .acceptance-box .checkbox-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 2;
            min-width: 230px;
        }
        .acceptance-box input[type="checkbox"] {
            width: 22px;
            height: 22px;
            accent-color: var(--accent-blue);
            cursor: pointer;
            flex-shrink: 0;
        }
        .acceptance-box label {
            font-weight: 600;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 0.95rem;
            user-select: none;
        }
        .acceptance-box label a {
            color: var(--accent-blue);
            text-decoration: underline;
            font-weight: 600;
        }

        /* ========== START LEARNING BUTTON (READABLE) ========== */
        .start-learning-btn {
            background: var(--btn-disabled-bg);
            color: #fff;
            border: none;
            padding: 14px 34px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.2rem;
            cursor: default;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            white-space: nowrap;
            box-shadow: var(--shadow-sm);
            opacity: 0.55;
            pointer-events: none;
            user-select: none;
            letter-spacing: 0.5px;
        }
        .start-learning-btn.enabled {
            opacity: 1;
            pointer-events: auto;
            user-select: auto;
            cursor: pointer;
            background: var(--accent-blue);
            box-shadow: 0 6px 22px rgba(37, 99, 235, 0.35);
            color: #fff;
        }
        .start-learning-btn.enabled:hover {
            background: var(--accent-blue-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(37, 99, 235, 0.45);
        }
        .start-learning-btn .icon-rocket {
            font-size: 1.4rem;
        }

        /* ========== POLICY CONTENT ========== */
        .policy-card .last-updated {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 28px;
            font-style: italic;
        }
        .policy-card h2 {
            font-size: 1.5rem;
            color: var(--text-primary);
            margin: 28px 0 14px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border-light);
            transition: color 0.3s;
        }
        .policy-card h3 {
            font-size: 1.2rem;
            color: var(--text-primary);
            margin: 24px 0 10px;
        }
        .policy-card p,
        .policy-card li {
            font-size: 0.98rem;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }
        .policy-card ul {
            padding-left: 24px;
            margin-bottom: 18px;
        }
        .policy-card strong {
            color: var(--text-primary);
        }
        .policy-card a {
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: 500;
        }
        .policy-card a:hover {
            text-decoration: underline;
        }

        /* ========== CONTACT BOX ========== */
        .contact-box {
            background: var(--accept-bg);
            border-radius: var(--radius-md);
            padding: 24px 28px;
            margin-top: 28px;
            text-align: center;
            border: 1px solid var(--border-light);
        }

        /* ========== FOOTER ========== */
        .footer {
            background: var(--nav-bg);
            color: #94a3b8;
            text-align: center;
            padding: 22px 20px;
            font-size: 0.88rem;
            transition: background-color 0.3s;
        }
        .footer span {
            color: #60a5fa;
            font-weight: 600;
        }
        .footer a {
            color: #cbd5e1;
            text-decoration: none;
            margin: 0 6px;
        }
        .footer a:hover {
            color: #60a5fa;
        }

        /* ========== COOKIE BANNER & MODAL (original) ========== */
        #cookie-consent-banner {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--cookie-banner-bg);
            color: var(--cookie-banner-text);
            padding: 18px 24px;
            z-index: 9999;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            box-shadow: 0 -6px 30px rgba(0,0,0,0.35);
            transform: translateY(100%);
            transition: transform 0.4s ease-in-out, background-color 0.3s;
            border-top: 2px solid #334155;
        }
        #cookie-consent-banner .banner-text {
            flex: 1;
            min-width: 240px;
        }
        #cookie-consent-banner .banner-text strong {
            font-size: 1.05rem;
            color: #fff;
        }
        #cookie-consent-banner .banner-text p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }
        #cookie-consent-banner .banner-text a {
            color: #60a5fa;
            text-decoration: underline;
        }
        #cookie-consent-banner .banner-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }
        #cookie-consent-banner .banner-buttons button {
            padding: 10px 20px;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s ease;
            border: 2px solid transparent;
            white-space: nowrap;
        }
        .btn-reject, .btn-customise {
            background: transparent;
            color: #94a3b8;
            border-color: #475569;
        }
        .btn-reject:hover, .btn-customise:hover {
            border-color: #cbd5e1;
            color: #e2e8f0;
        }
        .btn-accept {
            background: var(--accent-blue);
            color: #fff;
            border-color: var(--accent-blue);
        }
        .btn-accept:hover {
            background: var(--accent-blue-hover);
            border-color: var(--accent-blue-hover);
        }

        #cookie-preferences-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15,23,42,0.7);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .modal-content {
            background: var(--modal-bg);
            border-radius: var(--radius-lg);
            padding: 30px 26px;
            max-width: 520px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            color: var(--text-primary);
            transition: background-color 0.3s;
        }
        .modal-content h2 {
            margin-top: 0;
            color: var(--text-primary);
            font-size: 1.4rem;
        }
        .modal-desc {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 18px;
        }
        .cookie-option {
            margin-bottom: 12px;
            padding: 14px 16px;
            background: var(--cookie-option-bg);
            border-radius: var(--radius-sm);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            border: 1px solid var(--border-light);
            transition: background-color 0.3s;
        }
        .cookie-option strong {
            font-size: 0.9rem;
            color: var(--text-primary);
        }
        .cookie-option p {
            margin: 2px 0 0;
            font-size: 0.78rem;
            color: var(--text-muted);
        }
        .cookie-option input[type="checkbox"] {
            accent-color: var(--accent-blue);
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }
        .modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 8px;
        }
        .modal-buttons button {
            padding: 10px 22px;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s ease;
        }
        .btn-cancel {
            background: transparent;
            color: var(--text-primary);
            border: 2px solid #d1d5db;
        }
        .btn-cancel:hover {
            border-color: #9ca3af;
        }
        .btn-save {
            background: var(--accent-blue);
            color: #fff;
            border: none;
        }
        .btn-save:hover {
            background: var(--accent-blue-hover);
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 479px) {
            .navbar { flex-direction: column; text-align: center; }
            .start-learning-btn { width: 100%; justify-content: center; }
            .attention-note { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
