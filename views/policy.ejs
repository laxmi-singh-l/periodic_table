                    <strong>Response Time:</strong> We aim to respond within 30 days for privacy requests.
                </p>
            </div>
        </article>
    </main>

    <!-- FOOTER -->
    <footer class="footer" role="contentinfo">
        &copy; <span id="year"></span> <span>Periodic Instructor</span> – ASR Group. &nbsp;|&nbsp;
        <a href="/terms">Terms</a> |
        <a href="/cookie">Cookies</a>
    </footer>

    <!-- COOKIE CONSENT BANNER -->
    <aside id="cookie-consent-banner" aria-label="Cookie consent banner">
        <div class="banner-text">
            <strong>🍪 Cookie Consent</strong>
            <p>We use cookies to enhance your experience, analyse traffic, and personalise content. By clicking "Accept All", you consent to our use of cookies. <a href="/cookie">Learn more</a>.</p>
        </div>
        <div class="banner-buttons">
            <button id="cookie-reject-all" class="btn-reject">Reject All</button>
            <button id="cookie-customise" class="btn-customise">Customise</button>
            <button id="cookie-accept-all" class="btn-accept">Accept All</button>
        </div>
    </aside>

    <!-- COOKIE PREFERENCES MODAL -->
    <div id="cookie-preferences-modal" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title">
        <div class="modal-content">
            <h2 id="cookie-modal-title">Cookie Preferences</h2>
            <p class="modal-desc">Manage your cookie settings. Essential cookies cannot be disabled.</p>
            <div class="cookie-option">
                <div><strong>Essential Cookies</strong><p>Required for core functionality. Always enabled.</p></div>
                <input type="checkbox" checked disabled>
            </div>
            <div class="cookie-option">
                <div><strong>Analytics Cookies</strong><p>Help us improve our content.</p></div>
                <input type="checkbox" id="analytics-cookies-checkbox" checked>
            </div>
            <div class="cookie-option">
                <div><strong>Functional Cookies</strong><p>Remember your preferences.</p></div>
                <input type="checkbox" id="functional-cookies-checkbox" checked>
            </div>
            <div class="modal-buttons">
                <button id="modal-cancel" class="btn-cancel">Cancel</button>
                <button id="modal-save" class="btn-save">Save Preferences</button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            // ========== THEME TOGGLE ==========
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');
            const body = document.body;

            const savedTheme = localStorage.getItem('periodic_theme') || 'light';
            if (savedTheme === 'dark') {
                body.classList.add('dark');
                themeIcon.textContent = '☀️';
                themeText.textContent = 'Light';
            }

            themeToggle.addEventListener('click', () => {
                body.classList.toggle('dark');
                const isDark = body.classList.contains('dark');
                localStorage.setItem('periodic_theme', isDark ? 'dark' : 'light');
                themeIcon.textContent = isDark ? '☀️' : '🌙';
                themeText.textContent = isDark ? 'Light' : 'Dark';
            });

            // ========== POLICY ACCEPTANCE & START LEARNING ==========
            const acceptCheckbox = document.getElementById('acceptPolicy');
            const startBtn = document.getElementById('startLearningBtn');

            function updateStartButton() {
                if (acceptCheckbox && startBtn) {
                    if (acceptCheckbox.checked) {
                        startBtn.classList.add('enabled');
                        startBtn.setAttribute('aria-disabled', 'false');
                    } else {
                        startBtn.classList.remove('enabled');
                        startBtn.setAttribute('aria-disabled', 'true');
                    }
                }
            }
            acceptCheckbox.addEventListener('change', updateStartButton);
            updateStartButton();

            window.handleStartLearning = function(event) {
                if (!acceptCheckbox || !acceptCheckbox.checked) {
                    event.preventDefault();
                    alert('Please read and accept the Privacy Policy and Terms of Service before proceeding.');
                    return false;
                }
                return true;
            };

            // ========== COOKIE CONSENT (original logic) ==========
            const banner = document.getElementById('cookie-consent-banner');
            const modal = document.getElementById('cookie-preferences-modal');
            const acceptAllBtn = document.getElementById('cookie-accept-all');
            const rejectAllBtn = document.getElementById('cookie-reject-all');
            const customiseBtn = document.getElementById('cookie-customise');
            const modalCancel = document.getElementById('modal-cancel');
            const modalSave = document.getElementById('modal-save');
            const analyticsCheckbox = document.getElementById('analytics-cookies-checkbox');
            const functionalCheckbox = document.getElementById('functional-cookies-checkbox');

            const STORAGE_KEY = 'periodic_instructor_cookie_consent';
            const consentData = localStorage.getItem(STORAGE_KEY);

            if (!consentData) {
                setTimeout(() => { if (banner) banner.style.transform = 'translateY(0)'; }, 600);
            } else {
                if (banner) banner.style.display = 'none';
                applyConsent(JSON.parse(consentData));
            }

            function saveConsent(consentObj) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(consentObj));
                if (banner) {
                    banner.style.transform = 'translateY(100%)';
                    setTimeout(() => { if (banner) banner.style.display = 'none'; }, 400);
                }
                applyConsent(consentObj);
            }

            function applyConsent(consentObj) {
                if (consentObj.analytics) enableGoogleAnalytics(); else disableGoogleAnalytics();
                if (consentObj.functional) enableFunctionalCookies(); else disableFunctionalCookies();
            }

            acceptAllBtn?.addEventListener('click', () => saveConsent({
                essential: true, analytics: true, functional: true, timestamp: new Date().toISOString()
            }));
            rejectAllBtn?.addEventListener('click', () => saveConsent({
                essential: true, analytics: false, functional: false, timestamp: new Date().toISOString()
            }));
            customiseBtn?.addEventListener('click', () => {
                const existing = localStorage.getItem(STORAGE_KEY);
                if (existing) {
                    const p = JSON.parse(existing);
                    if (analyticsCheckbox) analyticsCheckbox.checked = p.analytics !== false;
                    if (functionalCheckbox) functionalCheckbox.checked = p.functional !== false;
                }
                if (modal) modal.style.display = 'flex';
            });
            modalCancel?.addEventListener('click', () => { if (modal) modal.style.display = 'none'; });
            modal?.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });
            modalSave?.addEventListener('click', () => {
                saveConsent({
                    essential: true,
                    analytics: analyticsCheckbox?.checked ?? true,
                    functional: functionalCheckbox?.checked ?? true,
                    timestamp: new Date().toISOString()
                });
                if (modal) modal.style.display = 'none';
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modal && modal.style.display === 'flex') modal.style.display = 'none';
            });

            function enableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') gtag('consent', 'update', { 'analytics_storage': 'granted' });
            }
            function disableGoogleAnalytics() {
                if (typeof gtag !== 'undefined') gtag('consent', 'update', { 'analytics_storage': 'denied' });
                document.cookie.split(';').forEach(c => {
                    const trimmed = c.trim();
                    if (trimmed.startsWith('_ga') || trimmed.startsWith('_gid') || trimmed.startsWith('_gat')) {
                        document.cookie = trimmed.split('=')[0] + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    }
                });
            }
            function enableFunctionalCookies() {
                const theme = localStorage.getItem('preferred_theme');
                if (theme) document.body.className = theme;
            }
            function disableFunctionalCookies() {
                localStorage.removeItem('preferred_theme');
            }

            // Footer year
            document.getElementById('year').textContent = new Date().getFullYear();
        })();
    </script>
</body>
</html>