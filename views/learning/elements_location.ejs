      { z: 97, name: "Berkelium", symbol: "Bk", config: "[Rn] 5f⁹ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 98, name: "Californium", symbol: "Cf", config: "[Rn] 5f¹⁰ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 99, name: "Einsteinium", symbol: "Es", config: "[Rn] 5f¹¹ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 100, name: "Fermium", symbol: "Fm", config: "[Rn] 5f¹² 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 101, name: "Mendelevium", symbol: "Md", config: "[Rn] 5f¹³ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 102, name: "Nobelium", symbol: "No", config: "[Rn] 5f¹⁴ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 103, name: "Lawrencium", symbol: "Lr", config: "[Rn] 5f¹⁴ 6d¹ 7s²", block: "f", period: 7, group: "3", valence: 2 },
      { z: 104, name: "Rutherfordium", symbol: "Rf", config: "[Rn] 5f¹⁴ 6d² 7s²", block: "d", period: 7, group: "4", valence: 2 },
      { z: 105, name: "Dubnium", symbol: "Db", config: "[Rn] 5f¹⁴ 6d³ 7s²", block: "d", period: 7, group: "5", valence: 2 },
      { z: 106, name: "Seaborgium", symbol: "Sg", config: "[Rn] 5f¹⁴ 6d⁴ 7s²", block: "d", period: 7, group: "6", valence: 2 },
      { z: 107, name: "Bohrium", symbol: "Bh", config: "[Rn] 5f¹⁴ 6d⁵ 7s²", block: "d", period: 7, group: "7", valence: 2 },
      { z: 108, name: "Hassium", symbol: "Hs", config: "[Rn] 5f¹⁴ 6d⁶ 7s²", block: "d", period: 7, group: "8", valence: 2 },
      { z: 109, name: "Meitnerium", symbol: "Mt", config: "[Rn] 5f¹⁴ 6d⁷ 7s²", block: "d", period: 7, group: "9", valence: 2 },
      { z: 110, name: "Darmstadtium", symbol: "Ds", config: "[Rn] 5f¹⁴ 6d⁸ 7s²", block: "d", period: 7, group: "10", valence: 2 },
      { z: 111, name: "Roentgenium", symbol: "Rg", config: "[Rn] 5f¹⁴ 6d⁹ 7s²", block: "d", period: 7, group: "11", valence: 2 },
      { z: 112, name: "Copernicium", symbol: "Cn", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s²", block: "d", period: 7, group: "12", valence: 2 },
      { z: 113, name: "Nihonium", symbol: "Nh", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p¹", block: "p", period: 7, group: "13", valence: 3 },
      { z: 114, name: "Flerovium", symbol: "Fl", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p²", block: "p", period: 7, group: "14", valence: 4 },
      { z: 115, name: "Moscovium", symbol: "Mc", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p³", block: "p", period: 7, group: "15", valence: 5 },
      { z: 116, name: "Livermorium", symbol: "Lv", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p⁴", block: "p", period: 7, group: "16", valence: 6 },
      { z: 117, name: "Tennessine", symbol: "Ts", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p⁵", block: "p", period: 7, group: "17", valence: 7 },
      { z: 118, name: "Oganesson", symbol: "Og", config: "[Rn] 5f¹⁴ 6d¹⁰ 7s² 7p⁶", block: "p", period: 7, group: "18", valence: 8 }
    ];

    // DOM Elements
    const calcForm = document.getElementById('calcForm');
    const atomicInput = document.getElementById('atomicInput');
    const errorBox = document.getElementById('errorBox');
    const resultBox = document.getElementById('resultBox');
    const clearBtn = document.getElementById('clearBtn');

    // Result Nodes
    const resAtomicNum = document.getElementById('resAtomicNum');
    const resSymbol = document.getElementById('resSymbol');
    const resName = document.getElementById('resName');
    const resCategory = document.getElementById('resCategory');
    const resBlock = document.getElementById('resBlock');
    const resPeriod = document.getElementById('resPeriod');
    const resGroup = document.getElementById('resGroup');
    const resValence = document.getElementById('resValence');
    const resConfig = document.getElementById('resConfig');
    const resExplanation = document.getElementById('resExplanation');

    // Handle Form Submit
    calcForm.addEventListener('submit', function(e) {
      e.preventDefault();
      calculatePosition();
    });

    // Handle Clear Button
    clearBtn.addEventListener('click', function() {
      atomicInput.value = '';
      errorBox.style.display = 'none';
      resultBox.style.display = 'none';
      atomicInput.focus();
    });

    // Quick Calculate Chip Action
    function quickCalculate(num) {
      atomicInput.value = num;
      calculatePosition();
    }

    // Calculation Logic
    function calculatePosition() {
      const num = parseInt(atomicInput.value, 10);

      // Validation
      if (isNaN(num) || num < 1 || num > 118) {
        errorBox.style.display = 'block';
        resultBox.style.display = 'none';
        return;
      }

      errorBox.style.display = 'none';

      // Find Element in DB
      const element = elementsDB.find(el => el.z === num);

      if (!element) {
        errorBox.textContent = 'Element data not found.';
        errorBox.style.display = 'block';
        resultBox.style.display = 'none';
        return;
      }

      // Populate Data
      resAtomicNum.textContent = `Z = ${element.z}`;
      resSymbol.textContent = element.symbol;
      resName.textContent = element.name;
      resCategory.textContent = `${element.block.toUpperCase()}-Block Element`;
      resBlock.textContent = `${element.block}-block`;
      resPeriod.textContent = element.period;
      resGroup.textContent = element.group;
      resValence.textContent = element.valence;
      resConfig.textContent = element.config;

      // Generate Explanation Text
      let explanation = "";

      if (element.block === "s") {
        if (element.z === 2) {
          explanation = `Helium (He) has the electronic configuration <strong>1s²</strong>. Even though the last electron enters the 1s subshell (s-block), Helium is placed in <strong>Group 18</strong> because its outermost shell is completely filled (duplet rule), behaving like a noble gas in Period 1.`;
        } else {
          explanation = `The last electron enters the <strong>${element.period}s</strong> subshell. Therefore, ${element.name} belongs to the <strong>s-block</strong>. The highest principal quantum number is <strong>n = ${element.period}</strong> (Period ${element.period}). Since there are <strong>${element.valence}</strong> electron(s) in the outermost s-subshell, the Group number is <strong>Group ${element.group}</strong>.`;
        }
      } else if (element.block === "p") {
        explanation = `The last electron enters the <strong>${element.period}p</strong> subshell. Therefore, ${element.name} belongs to the <strong>p-block</strong>. The highest principal quantum number is <strong>n = ${element.period}</strong> (Period ${element.period}). According to p-block rules: Group = 12 + valence p-electrons = <strong>Group ${element.group}</strong>.`;
      } else if (element.block === "d") {
        explanation = `The last electron enters the inner <strong>(n-1)d</strong> subshell. Therefore, ${element.name} belongs to the <strong>d-block</strong> (Transition Element). The highest outer principal quantum number is <strong>n = ${element.period}</strong> (Period ${element.period}). Group = (n-1)d electrons + ns electrons = <strong>Group ${element.group}</strong>.`;
      } else if (element.block === "f") {
        const series = element.period === 6 ? "Lanthanide" : "Actinide";
        explanation = `The last electron enters the inner <strong>(n-2)f</strong> subshell. Therefore, ${element.name} belongs to the <strong>f-block</strong> (${series} inner transition series). The highest outer quantum shell is <strong>n = ${element.period}</strong> (Period ${element.period}). All f-block elements are placed in <strong>Group 3</strong> of the periodic table.`;
      }

      resExplanation.innerHTML = explanation;

      // Display with smooth animation
      resultBox.style.display = 'block';
      resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</body>
</html>