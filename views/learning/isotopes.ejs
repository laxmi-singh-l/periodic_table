    <!-- JavaScript -->
    <script>
        // DOM Elements
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const navLinks = document.getElementById('navLinks');
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const progressBar = document.getElementById('progressBar');
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        const sections = document.querySelectorAll('section');
        const navItems = document.querySelectorAll('.nav-links a');
        const typewriter = document.getElementById('typewriter');

        // Theme Toggle Logic
        let isLight = false;
        themeToggle.addEventListener('click', () => {
            isLight = !isLight;
            document.body.setAttribute('data-theme', isLight ? 'light' : 'dark');
            // Change Icon (Sun/Moon)
            if(isLight) {
                themeIcon.innerHTML = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>`;
            } else {
                themeIcon.innerHTML = `
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                `;
            }
        });

        // Mobile Menu Toggle
        mobileMenuBtn.addEventListener('click', () => {
            navLinks.classList.toggle('nav-active');
            mobileMenuBtn.textContent = navLinks.classList.contains('nav-active') ? '✕' : '☰';
        });

        // Close mobile menu on link click
        navItems.forEach(item => {
            item.addEventListener('click', () => {
                if(window.innerWidth <= 768) {
                    navLinks.classList.remove('nav-active');
                    mobileMenuBtn.textContent = '☰';
                }
            });
        });

        // Scroll Events (Progress Bar, Sticky Nav Active State, Scroll To Top)
        window.addEventListener('scroll', () => {
            // Progress bar
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            progressBar.style.width = scrolled + "%";

            // Scroll to top button
            if (winScroll > 500) {
                scrollTopBtn.classList.add('visible');
            } else {
                scrollTopBtn.classList.remove('visible');
            }

            // Active nav link highlighting
            let current = "";
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (pageYOffset >= sectionTop - 150) {
                    current = section.getAttribute("id");
                }
            });
            if(pageYOffset < 300) current = "home";

            navItems.forEach(li => {
                li.classList.remove("active");
                if (li.getAttribute("href").includes(current)) {
                    li.classList.add("active");
                }
            });
        });

        // Scroll to Top action
        scrollTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Reveal Animations on Scroll
        const revealElements = document.querySelectorAll('.reveal');
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        revealElements.forEach(el => revealObserver.observe(el));

        // Typewriter Effect
        const phrases = ["Isotopes", "Isobars", "Isotones", "Class 11 Chemistry", "Master Atomic Structure"];
        let phraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;

        function typeEffect() {
            const currentPhrase = phrases[phraseIndex];
            
            if(isDeleting) {
                typewriter.textContent = currentPhrase.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typewriter.textContent = currentPhrase.substring(0, charIndex + 1);
                charIndex++;
            }

            let typeSpeed = isDeleting ? 50 : 100;

            if(!isDeleting && charIndex === currentPhrase.length) {
                typeSpeed = 2000;
                isDeleting = true;
            } else if(isDeleting && charIndex === 0) {
                isDeleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
                typeSpeed = 500;
            }

            setTimeout(typeEffect, typeSpeed);
        }
        setTimeout(typeEffect, 1000);

        // Ripple Effect for buttons
        document.querySelectorAll('.ripple-btn').forEach(button => {
            button.addEventListener('click', function(e) {
                const x = e.clientX - e.target.getBoundingClientRect().left;
                const y = e.clientY - e.target.getBoundingClientRect().top;
                
                const ripple = document.createElement('span');
                ripple.classList.add('ripple');
                ripple.style.left = `${x}px`;
                ripple.style.top = `${y}px`;
                
                this.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });
        });

        // --- QUIZ LOGIC ---
        const quizData = [
            // Isotopes (3)
            {
                q: "What defines isotopes of an element?",
                options: [
                    "Same mass number, different atomic number",
                    "Same atomic number, different mass number",
                    "Same number of neutrons",
                    "Different chemical properties"
                ],
                correct: 1,
                explanation: "Isotopes are atoms of the same element, meaning they share the same atomic number (protons) but have a different mass number due to varying neutrons."
            },
            {
                q: "Which isotope of Carbon is commonly used in archaeological dating?",
                options: ["Carbon-12", "Carbon-13", "Carbon-14", "Carbon-15"],
                correct: 2,
                explanation: "Carbon-14 is a radioactive isotope of carbon used in radiocarbon dating to determine the age of organic materials."
            },
            {
                q: "Why do isotopes of the same element exhibit identical chemical properties?",
                options: [
                    "They have the same atomic mass",
                    "They have the same number of neutrons",
                    "They have the same number of electrons",
                    "They exist in the same physical state"
                ],
                correct: 2,
                explanation: "Chemical properties are dictated by electron configuration. Since isotopes have the same number of protons, they have the same number of electrons."
            },
            // Isobars (3)
            {
                q: "Argon-40 and Calcium-40 are examples of:",
                options: ["Isotopes", "Isotones", "Isobars", "Isomers"],
                correct: 2,
                explanation: "They have different atomic numbers (Ar=18, Ca=20) but share the exact same mass number (40), making them Isobars."
            },
            {
                q: "Which statement is true regarding Isobars?",
                options: [
                    "They have the same number of protons.",
                    "They belong to the same element.",
                    "They have completely different chemical properties.",
                    "They have the same number of neutrons."
                ],
                correct: 2,
                explanation: "Since isobars belong to different elements (different atomic numbers), their electron configurations are different, leading to completely different chemical properties."
            },
            {
                q: "In the pair Carbon-14 and Nitrogen-14, which subatomic particles sum up to the same number?",
                options: ["Electrons + Protons", "Protons + Neutrons", "Neutrons + Electrons", "Only Protons"],
                correct: 1,
                explanation: "The mass number is 14 for both. Mass number is the sum of Protons and Neutrons (Nucleons)."
            },
            // Isotones (4)
            {
                q: "What is the defining characteristic of Isotones?",
                options: [
                    "Same number of protons",
                    "Same mass number",
                    "Same number of electrons",
                    "Same number of neutrons"
                ],
                correct: 3,
                explanation: "Isotones are atoms of different elements that share exactly the same number of neutrons."
            },
            {
                q: "Calculate the neutrons to determine which pair are Isotones:",
                options: [
                    "C-12 and C-14",
                    "Ar-40 and Ca-40",
                    "C-14 (Z=6) and N-15 (Z=7)",
                    "U-235 and U-238"
                ],
                correct: 2,
                explanation: "For C-14: 14 - 6 = 8 neutrons. For N-15: 15 - 7 = 8 neutrons. They share the same neutron count."
            },
            {
                q: "Oxygen-18 (Z=8) and Fluorine-19 (Z=9) are isotones because they both contain:",
                options: ["8 neutrons", "9 neutrons", "10 neutrons", "11 neutrons"],
                correct: 2,
                explanation: "Oxygen-18: 18 - 8 = 10. Fluorine-19: 19 - 9 = 10. Both have 10 neutrons."
            },
            {
                q: "If Element X has A=31, Z=15 and Element Y has A=32, Z=16, what is their relationship?",
                options: ["Isotopes", "Isobars", "Isotones", "None of the above"],
                correct: 2,
                explanation: "Element X neutrons = 31 - 15 = 16. Element Y neutrons = 32 - 16 = 16. Same neutrons = Isotones."
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let answered = false;

        const questionText = document.getElementById('questionText');
        const optionsContainer = document.getElementById('optionsContainer');
        const explanationBox = document.getElementById('explanationBox');
        const nextBtn = document.getElementById('nextBtn');
        const questionCount = document.getElementById('questionCount');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const quizProgress = document.getElementById('quizProgress');
        const quizContent = document.getElementById('quizContent');
        const quizResult = document.getElementById('quizResult');
        const finalScoreText = document.getElementById('finalScoreText');
        const finalFeedback = document.getElementById('finalFeedback');
        const restartBtn = document.getElementById('restartBtn');

        function loadQuestion() {
            answered = false;
            const q = quizData[currentQuestion];
            questionText.textContent = `${currentQuestion + 1}. ${q.q}`;
            questionCount.textContent = `Question ${currentQuestion + 1}/${quizData.length}`;
            quizProgress.style.width = `${(currentQuestion / quizData.length) * 100}%`;
            
            optionsContainer.innerHTML = '';
            explanationBox.classList.remove('visible');
            nextBtn.classList.remove('visible');

            q.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.classList.add('option-btn');
                btn.textContent = opt;
                btn.addEventListener('click', () => checkAnswer(index, btn));
                optionsContainer.appendChild(btn);
            });
        }

        function checkAnswer(selectedIndex, btn) {
            if (answered) return;
            answered = true;
            
            const q = quizData[currentQuestion];
            const buttons = optionsContainer.querySelectorAll('.option-btn');
            
            buttons.forEach(b => b.disabled = true);

            if (selectedIndex === q.correct) {
                btn.classList.add('correct');
                score++;
                scoreDisplay.textContent = `Score: ${score}`;
            } else {
                btn.classList.add('wrong');
                buttons[q.correct].classList.add('correct');
            }

            explanationBox.innerHTML = `<strong>Explanation:</strong> ${q.explanation}`;
            explanationBox.classList.add('visible');
            nextBtn.classList.add('visible');
        }

        nextBtn.addEventListener('click', () => {
            currentQuestion++;
            if (currentQuestion < quizData.length) {
                loadQuestion();
            } else {
                showResults();
            }
        });

        function showResults() {
            quizContent.style.display = 'none';
            quizResult.style.display = 'block';
            quizProgress.style.width = '100%';
            
            finalScoreText.textContent = `You scored: ${score} out of ${quizData.length}`;
            
            if (score === quizData.length) {
                finalFeedback.textContent = "Perfect! You are an Atomic Structure Master! 🏆";
                fireConfetti();
            } else if (score >= 7) {
                finalFeedback.textContent = "Great job! You have a solid understanding. 🌟";
            } else if (score >= 4) {
                finalFeedback.textContent = "Good effort. Review the formulas and try again! 📚";
            } else {
                finalFeedback.textContent = "Keep learning! Read the theory sections again. 💡";
            }
        }

        restartBtn.addEventListener('click', () => {
            currentQuestion = 0;
            score = 0;
            scoreDisplay.textContent = `Score: 0`;
            quizContent.style.display = 'block';
            quizResult.style.display = 'none';
            loadQuestion();
        });

        // Initialize Quiz
        loadQuestion();

        // --- Simple Confetti Animation ---
        const canvas = document.getElementById('confetti');
        const ctx = canvas.getContext('2d');
        let particles = [];
        let animationId;

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function fireConfetti() {
            particles = [];
            const colors = ['#00f3ff', '#bc13fe', '#00ff88', '#ff3366', '#ffffff'];
            
            for(let i=0; i<150; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    w: Math.random() * 10 + 5,
                    h: Math.random() * 10 + 5,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    speed: Math.random() * 3 + 2,
                    angle: Math.random() * 360,
                    spin: Math.random() * 0.2 - 0.1
                });
            }
            
            cancelAnimationFrame(animationId);
            animateConfetti();
            
            setTimeout(() => {
                particles = [];
                ctx.clearRect(0,0,canvas.width,canvas.height);
            }, 5000);
        }

        function animateConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.y += p.speed;
                p.angle += p.spin;
                
                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.angle);
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
                ctx.restore();
            });
            animationId = requestAnimationFrame(animateConfetti);
        }

    </script>
</body>
</html>