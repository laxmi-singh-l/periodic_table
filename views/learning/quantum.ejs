        .short-line {
            background: #1a1a2e;
            padding: 0.5rem 1rem;
            border-radius: 30px;
            border-left: 4px solid #ffea00;
            font-family: 'Courier New', monospace;
            font-size: 0.95rem;
            word-break: break-word;
        }
        footer {
            margin-top: 3rem;
