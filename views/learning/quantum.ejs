</head>
<body>
    <header>
        <h1 class="neon-text">Quantum Numbers</h1>
        <p style="color:#aaa; margin-top:0.5rem;">Names, Limits, Derivation & Uses · Dark Neon Interactive</p>
        <nav aria-label="Main navigation">
            <a href="#principal" class="nav-btn">Principal (n)</a>
            <a href="#azimuthal" class="nav-btn">Azimuthal (l)</a>
            <a href="#magnetic" class="nav-btn">Magnetic (m<sub>l</sub>)</a>
            <a href="#spin" class="nav-btn">Spin (m<sub>s</sub>)</a>
            <a href="#interactive" class="nav-btn">Try It</a>
        </nav>
    </header>

    <main>
        <section class="fade-section">
            <h2 class="neon-cyan">What are Quantum Numbers?</h2>
            <p>
                Quantum numbers are a set of four values that completely describe the <strong>energy, position, orbital shape, and spin</strong> of an electron in an atom. They arise from the solution of the <span class="highlight">Schrodinger equation</span> and serve as a unique "address" for every electron's quantum state.
            </p>
            <ul style="list-style-type: none; padding-left: 1rem; margin-top:1rem;">
                <li>- <strong>Principal Quantum Number (n)</strong></li>
                <li>- <strong>Azimuthal / Orbital Angular Momentum Quantum Number (l)</strong></li>
                <li>- <strong>Magnetic Quantum Number (m<sub>l</sub>)</strong></li>
                <li>- <strong>Spin Quantum Number (m<sub>s</sub>)</strong></li>
            </ul>
        </section>

        <article id="principal" class="fade-section">
            <h2 class="neon-cyan">1. Principal Quantum Number (<em>n</em>)</h2>
            <div class="quantum-card">
                <div class="glow-box">
                    <p><strong>Name:</strong> Principal Quantum Number</p>
                    <p><strong>Value / Limit:</strong> <span class="neon-magenta">n = 1, 2, 3, ... &#8734;</span></p>
                    <p><strong>Derivation:</strong> Radial wave function; determines energy level and shell size.</p>
                    <p><strong>Use:</strong> Defines the main shell (K, L, M, N...).</p>
                    <div class="limit-badge">Limit: n &ge; 1 (integer)</div>
                </div>
            </div>
        </article>

        <article id="azimuthal" class="fade-section">
            <h2 class="neon-magenta">2. Azimuthal Quantum Number (<em>l</em>)</h2>
            <div class="quantum-card">
                <div class="glow-box">
                    <p><strong>Name:</strong> Azimuthal (Orbital Angular Momentum)</p>
                    <p><strong>Value / Limit:</strong> <span class="neon-cyan">l = 0, 1, 2, ..., (n-1)</span></p>
                    <p><strong>Derivation:</strong> Angular part; gives orbital shape (s, p, d, f).</p>
                    <p><strong>Use:</strong> Subshell designation.</p>
                    <div class="limit-badge">Limit: 0 &le; l &le; n-1</div>
                </div>
            </div>
        </article>

        <article id="magnetic" class="fade-section">
            <h2 class="neon-green">3. Magnetic Quantum Number (<em>m<sub>l</sub></em>)</h2>
            <div class="quantum-card">
                <div class="glow-box">
                    <p><strong>Name:</strong> Magnetic Quantum Number</p>
                    <p><strong>Value / Limit:</strong> <span class="neon-yellow">m<sub>l</sub> = -l ... +l</span></p>
                    <p><strong>Derivation:</strong> z-component of angular momentum; orientation in magnetic field.</p>
                    <p><strong>Use:</strong> Orbital orientation (p<sub>x</sub>, p<sub>y</sub>, p<sub>z</sub>).</p>
                    <div class="limit-badge">Limit: (2l+1) values</div>
                </div>
            </div>
        </article>

        <article id="spin" class="fade-section">
            <h2 class="neon-orange">4. Spin Quantum Number (<em>m<sub>s</sub></em>)</h2>
            <div class="quantum-card">
                <div class="glow-box">
                    <p><strong>Name:</strong> Spin Quantum Number</p>
                    <p><strong>Value / Limit:</strong> <span class="neon-cyan">m<sub>s</sub> = +&frac12; or &minus;&frac12;</span></p>
                    <p><strong>Derivation:</strong> Intrinsic electron spin (Stern-Gerlach).</p>
                    <p><strong>Use:</strong> Pauli principle - max 2 electrons per orbital.</p>
                    <div class="limit-badge">Limit: only two values</div>
                </div>
            </div>
        </article>

        <section class="fade-section">
            <h2 class="neon-yellow">Relationship Among Quantum Numbers</h2>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>n</th>
                            <th>l (0..n-1)</th>
                            <th>m<sub>l</sub> (-l..+l)</th>
                            <th>Orbitals</th>
                            <th>Max e&minus;</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>0 (s)</td>
                            <td>0</td>
                            <td>1</td>
                            <td>2</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>0,1 (s,p)</td>
                            <td>0; -1,0,1</td>
                            <td>4</td>
                            <td>8</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>0,1,2</td>
                            <td>-2,-1,0,1,2</td>
                            <td>9</td>
                            <td>18</td>
                        </tr>
                        <tr>
                            <td>4</td>
                            <td>0,1,2,3</td>
                            <td>... (16 values)</td>
                            <td>16</td>
                            <td>32</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p style="margin-top:1rem;"><strong>Formulas:</strong> Orbitals = n&sup2;, Electrons = 2n&sup2;</p>
        </section>

        <section id="interactive" class="interactive fade-section">
            <h2 class="neon-magenta">Live Interactive: Maximum <em>l</em> State Only</h2>
            <label for="nInput" style="color:#00ffff;">Principal quantum number (n): </label>
            <input type="number" id="nInput" min="1" max="8" value="3">
            <button onclick="updateQuantum()">Show Max Subshell</button>
            <div id="result" class="output"></div>
        </section>
    </main>

    <footer>
        <p>Responsive Dark Neon Guide · Smooth Scroll · Fade Animations</p>
        <p>&copy; 2025 QuantumExplainer – Learn, Understand, Explore</p>
    </footer>

    <script>
        const fadeSections = document.querySelectorAll('.fade-section');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.2 });
        fadeSections.forEach(section => observer.observe(section));

        function updateQuantum() {
            const n = parseInt(document.getElementById('nInput').value);
            const resultDiv = document.getElementById('result');
            if (isNaN(n) || n < 1) {
                resultDiv.innerHTML = '<span style="color:#ff4444;">Please select n &ge; 1</span>';
                return;
            }
            
            const orbitalLabels = ['s', 'p', 'd', 'f', 'g', 'h', 'i', 'j'];
            let lineParts = [];
            let detailParts = [];

            // Calculate ONLY for the maximum value of 'l' (which is n - 1)
            const l = n - 1; 
            const orbital = orbitalLabels[l] || '?';
            const minMl = -l;
            const maxMl = l;
            
            let rangeStr;
            if (minMl === maxMl) {
                rangeStr = `0`;
            } else {
                rangeStr = `${minMl} to ${maxMl}`;
            }
            const count = 2 * l + 1; // Orbitals in this specific subshell
            
            // For short one-line display
            lineParts.push(`l=${l}(${orbital}) ml:${rangeStr}`);
            
            // For detailed breakdown
            detailParts.push(
                `<span style="display:inline-block; margin-right:1rem; background:#1a1a2e; padding:0.1rem 0.8rem; border-radius:16px;">l=${l}(${orbital})  mₗ = ${rangeStr}  (${count} values)</span>`
            );

            // Calculating electrons and orbitals ONLY for this max subshell
            const subshellOrbitals = count;
            const subshellElectrons = count * 2;
            
            // Build compact line
            const shortLine = `n=${n}  →  ${lineParts[0]}  →  subshell orbitals:${subshellOrbitals}  e⁻:${subshellElectrons}`;

            let fullOutput = `<div style="font-size:1rem; line-height:1.6;">`;
            fullOutput += `<p><strong>n = ${n} (Max Subshell Only)</strong>  |  Orbitals in this subshell: ${subshellOrbitals}  |  Max electrons: ${subshellElectrons}</p>`;
            fullOutput += `<div class="short-line">${shortLine}</div>`;
            fullOutput += `<div style="margin-top:0.8rem; font-size:0.95rem; background:#111; padding:0.6rem 1rem; border-radius:20px;">`;
            fullOutput += detailParts[0];
            fullOutput += `</div>`;
            fullOutput += `</div>`;

            resultDiv.innerHTML = fullOutput;
        }

        window.onload = updateQuantum;
    </script>
</body>
</html>