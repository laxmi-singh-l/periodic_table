        }
        tbody tr:hover td {
            background: #00ffff0d;
        }
        .interactive {
            text-align: center;
        }
        input,
        button {
            background: #0a0a0a;
            border: 1px solid #00ffff;
            color: #00ffff;
            padding: 0.7rem 1.5rem;
            border-radius: 40px;
            margin: 0.5rem;
            font-size: 1rem;
            outline: none;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }
        input[type="number"] {
            width: 100px;
            text-align: center;
        }
        button {
            background: #00ffff;
            color: #000;
            box-shadow: 0 0 8px #00ffff66;
            border: none;
        }
        button:hover {
            background: #00dddd;
            box-shadow: 0 0 14px #00ffff99;
            transform: translateY(-2px);
        }
        button:active {
            transform: scale(0.96);
        }
        .output {
            font-size: 1.2rem;
            margin: 1.5rem auto;
            color: #ffea00;
            text-shadow: 0 0 4px #ffea0066;
            text-align: left;
            display: inline-block;
            background: #0d0d0d;
            padding: 1.2rem 1.8rem;
            border-radius: 16px;
            border: 1px solid #ffea0033;
            width: 100%;
            max-width: 800px;
        }
        .output p {
            margin: 0.4rem 0;
