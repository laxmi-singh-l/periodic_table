<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bohr-Bury Electronic Configuration | Premium Guide</title>
    <style>
        /* CSS Variables for Neon Dark Theme & Glassmorphism */
        :root {
            --bg-main: #050914;
            --glass-bg: rgba(13, 22, 38, 0.55);
            --glass-border: rgba(0, 243, 255, 0.15);
            --neon-cyan: #00f3ff;
            --neon-blue: #0066ff;
            --neon-pink: #ff007f;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --success: #00ff66;
            --danger: #ff3366;
            --font-main: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        /* Global Reset & Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }
        
        body {
            background-color: var(--bg-main);
            color: var(--text-light);
            font-family: var(--font-main);
            line-height: 1.6;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(0, 102, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(0, 243, 255, 0.08) 0%, transparent 50%);
            background-attachment: fixed;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--bg-main); }
        ::-webkit-scrollbar-thumb { background: var(--neon-blue); border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--neon-cyan); }

        /* Scroll Progress Bar */
        #scroll-progress {
            position: fixed; top: 0; left: 0; width: 0%; height: 4px;
            background: linear-gradient(90deg, var(--neon-blue), var(--neon-cyan));
            z-index: 9999;
            box-shadow: 0 0 10px var(--neon-cyan);
        }

        /* Sticky Navigation */
        nav {
            position: fixed; top: 0; width: 100%;
            background: rgba(5, 9, 20, 0.85);
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--glass-border);
            z-index: 1000;
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 5%;
            transition: all 0.3s ease;
        }
        .nav-logo { font-size: 1.5rem; font-weight: 800; color: var(--text-light); text-shadow: 0 0 8px var(--neon-cyan); }
        .nav-logo span { color: var(--neon-cyan); }
        .nav-links { display: flex; gap: 20px; list-style: none; }
        .nav-links a { 
            color: var(--text-light); text-decoration: none; font-weight: 500;
            transition: color 0.3s, text-shadow 0.3s;
        }
        .nav-links a:hover { color: var(--neon-cyan); text-shadow: 0 0 8px var(--neon-cyan); }
        
        .menu-toggle { display: none; font-size: 1.5rem; cursor: pointer; color: var(--neon-cyan); }

        /* Search Box */
        .search-container { position: relative; }
        .search-container input {
            background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);
            color: white; padding: 8px 15px; border-radius: 20px; outline: none;
            transition: 0.3s; width: 200px;
        }
        .search-container input:focus { border-color: var(--neon-cyan); box-shadow: 0 0 10px rgba(0, 243, 255, 0.2); }
        .shortcut-hint { position: absolute; right: 10px; top: 8px; font-size: 0.7rem; color: var(--text-muted); }

        /* Hero Section */
        .hero {
            padding: 120px 5% 60px; text-align: center;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
        }
        .hero h1 { 
            font-size: 3.5rem; margin-bottom: 20px;
            background: linear-gradient(to right, #fff, var(--neon-cyan));
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(0, 243, 255, 0.3);
        }
        .hero p { font-size: 1.2rem; color: var(--text-muted); max-width: 800px; margin-bottom: 30px; }

        /* Glassmorphism Cards (Sections) */
        .container { max-width: 1200px; margin: 0 auto; padding: 20px 5%; }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 30px; margin-bottom: 40px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
            opacity: 0; transform: translateY(40px); /* For Reveal Animation */
        }
        .glass-card.visible { opacity: 1; transform: translateY(0); }
        .glass-card:hover { border-color: rgba(0, 243, 255, 0.4); box-shadow: 0 10px 40px rgba(0, 243, 255, 0.1); }
        
        .section-title { 
            font-size: 2rem; color: var(--neon-cyan); margin-bottom: 20px; 
            border-bottom: 1px solid var(--glass-border); padding-bottom: 10px;
            display: flex; align-items: center; gap: 10px;
        }

        /* Typography & Content Formatting */
        p { margin-bottom: 15px; }
        strong { color: var(--neon-cyan); }
        ul { margin-left: 20px; margin-bottom: 15px; list-style-type: none; }
        ul li { margin-bottom: 10px; position: relative; padding-left: 25px; }
        ul li::before { content: '⚛️'; position: absolute; left: 0; top: 2px; font-size: 0.9rem; }

        /* Tables */
        table { width: 100%; border-collapse: collapse; margin: 20px 0; background: rgba(0,0,0,0.2); border-radius: 10px; overflow: hidden; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid var(--glass-border); }
        th { background: rgba(0, 243, 255, 0.1); color: var(--neon-cyan); font-weight: 600; }
        tr:hover { background: rgba(255,255,255,0.02); }

        /* Timeline */
        .timeline { border-left: 2px solid var(--neon-cyan); margin-left: 20px; padding-left: 20px; position: relative; }
        .timeline-event { margin-bottom: 25px; position: relative; }
        .timeline-event::before {
            content: ''; position: absolute; left: -27px; top: 5px; width: 12px; height: 12px;
            background: var(--bg-main); border: 2px solid var(--neon-cyan); border-radius: 50%;
            box-shadow: 0 0 10px var(--neon-cyan);
        }

        /* Generator UI */
        .generator-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center; }
        .input-group { display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px; }
        input[type="number"] {
            background: rgba(0,0,0,0.3); border: 1px solid var(--neon-blue);
            color: white; padding: 12px; border-radius: 8px; font-size: 1.1rem; outline: none;
        }
        input[type="number"]:focus { box-shadow: 0 0 15px rgba(0, 102, 255, 0.4); }
        
        .btn {
            background: linear-gradient(45deg, var(--neon-blue), var(--neon-cyan));
            color: #000; font-weight: bold; border: none; padding: 12px 24px;
            border-radius: 8px; cursor: pointer; font-size: 1.1rem;
            transition: all 0.3s; text-transform: uppercase; letter-spacing: 1px;
            display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
        }
        .btn:hover { transform: scale(1.05); box-shadow: 0 0 25px rgba(0, 243, 255, 0.6); }
        
        .result-box {
            background: rgba(0,0,0,0.3); border-radius: 10px; padding: 20px;
            border-left: 4px solid var(--neon-cyan); margin-top: 20px; font-size: 1.1rem;
        }

        /* SVG Animation & Canvas */
        #svg-container { width: 100%; max-width: 400px; margin: 0 auto; display: block; aspect-ratio: 1/1; }
        .electron { fill: var(--neon-pink); filter: drop-shadow(0 0 5px var(--neon-pink)); }
        .shell { fill: none; stroke: rgba(0, 243, 255, 0.2); stroke-width: 1.5; }
        .nucleus { fill: var(--neon-cyan); filter: drop-shadow(0 0 8px var(--neon-cyan)); }
        
        @keyframes orbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        /* Interactive Flashcards */
        .flashcard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
        .flashcard {
            perspective: 1000px; height: 150px; cursor: pointer;
        }
        .flashcard-inner {
            position: relative; width: 100%; height: 100%; text-align: center;
            transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); transform-style: preserve-3d;
        }
        .flashcard:hover .flashcard-inner { transform: rotateY(180deg); }
        .flashcard-front, .flashcard-back {
            position: absolute; width: 100%; height: 100%; backface-visibility: hidden;
            display: flex; align-items: center; justify-content: center; flex-direction: column;
            border-radius: 15px; border: 1px solid var(--glass-border); padding: 15px;
        }
        .flashcard-front { background: rgba(0, 102, 255, 0.1); }
        .flashcard-back { background: rgba(0, 243, 255, 0.1); transform: rotateY(180deg); color: var(--neon-cyan); }

        /* MCQ Quiz */
        .quiz-question { margin-bottom: 25px; padding: 20px; background: rgba(0,0,0,0.2); border-radius: 10px; border: 1px solid transparent; transition: 0.3s; }
        .quiz-options { display: flex; flex-direction: column; gap: 10px; margin-top: 15px; }
        .quiz-option {
            display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.05);
            padding: 12px; border-radius: 8px; cursor: pointer; border: 1px solid var(--glass-border); transition: 0.2s;
        }
        .quiz-option:hover { background: rgba(0, 243, 255, 0.1); }
        .quiz-option input[type="radio"] { cursor: pointer; transform: scale(1.2); accent-color: var(--neon-cyan); }
        
        .correct-ans { border-color: var(--success) !important; background: rgba(0, 255, 102, 0.1) !important; box-shadow: 0 0 10px rgba(0,255,102,0.2); }
        .wrong-ans { border-color: var(--danger) !important; background: rgba(255, 51, 102, 0.1) !important; }
        
        #scorecard { display: none; text-align: center; padding: 30px; background: rgba(0,0,0,0.4); border-radius: 15px; border: 2px solid var(--neon-cyan); margin-top: 30px; }
        .score-circle { width: 120px; height: 120px; border-radius: 50%; border: 5px solid var(--neon-cyan); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; margin: 0 auto 20px; color: var(--neon-cyan); box-shadow: 0 0 20px var(--neon-cyan), inset 0 0 20px var(--neon-cyan);}

        /* Floating Action Buttons */
        .fab-container { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; gap: 15px; z-index: 1000; }
        .fab {
            width: 50px; height: 50px; border-radius: 50%; background: var(--glass-bg);
            backdrop-filter: blur(5px); border: 1px solid var(--glass-border);
            color: var(--neon-cyan); font-size: 1.2rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .fab:hover { background: var(--neon-cyan); color: #000; transform: translateY(-5px); box-shadow: 0 0 15px var(--neon-cyan); }
        .fab-tooltip {
            position: absolute; right: 60px; background: #000; color: #fff; padding: 5px 10px;
            border-radius: 5px; font-size: 0.8rem; white-space: nowrap; opacity: 0; pointer-events: none; transition: 0.3s;
        }
        .fab:hover .fab-tooltip { opacity: 1; }

        /* Notes Box */
        .note-box { background: rgba(255, 204, 0, 0.1); border-left: 4px solid #ffcc00; padding: 15px; border-radius: 0 10px 10px 0; margin: 20px 0; }
        .danger-box { background: rgba(255, 51, 102, 0.1); border-left: 4px solid var(--danger); padding: 15px; border-radius: 0 10px 10px 0; margin: 20px 0; }

        /* Responsive Design */
        @media (max-width: 992px) {
            .generator-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 2.5rem; }
        }
        @media (max-width: 768px) {
            .nav-links {
                position: absolute; top: 100%; left: 0; width: 100%; background: rgba(5, 9, 20, 0.95);
                flex-direction: column; padding: 20px; text-align: center; gap: 15px;
                clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); transition: clip-path 0.4s ease-in-out;
            }
            .nav-links.active { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
            .menu-toggle { display: block; }
            .search-container input { width: 150px; }
            .hero { padding-top: 100px; }
            .fab-container { bottom: 20px; right: 20px; }
        }

        /* Print Styles */
        @media print {
            body { background: white; color: black; background-image: none; }
            .glass-card { background: transparent; border: 1px solid #ccc; box-shadow: none; color: black; margin-bottom: 20px; page-break-inside: avoid; opacity: 1; transform: none; }
            nav, .fab-container, .hero p, #generator-section, #quiz-section { display: none !important; }
            .section-title { color: black; border-bottom: 2px solid black; }
            .hero h1 { color: black; text-shadow: none; -webkit-text-fill-color: black; }
            table th { background: #eee; color: black; }
            td, th { border-color: #aaa; }
            * { text-shadow: none !important; box-shadow: none !important; }
        }
    </style>
</head>
