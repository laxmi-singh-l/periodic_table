    <!-- JavaScript Logic -->
    <script>
        // --- 1. UI & Navigation Logic ---
        
        // Scroll Progress
        window.onscroll = function() {
            let winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            let height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            let scrolled = (winScroll / height) * 100;
            document.getElementById("scroll-progress").style.width = scrolled + "%";
            
            // Section Reveal Animation
            let cards = document.querySelectorAll('.glass-card');
            cards.forEach(card => {
                let cardTop = card.getBoundingClientRect().top;
                if(cardTop < window.innerHeight - 50) {
                    card.classList.add('visible');
                }
            });
        };
        // Trigger initial reveal
        window.dispatchEvent(new Event('scroll'));

        // Mobile Menu
        function toggleMenu() {
            document.getElementById('navLinks').classList.toggle('active');
        }

        // Search Functionality
        document.getElementById('searchInput').addEventListener('input', function(e) {
            let filter = e.target.value.toLowerCase();
            let cards = document.querySelectorAll('.section-card');
            cards.forEach(card => {
                let text = card.innerText.toLowerCase();
                card.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if(e.altKey && e.key.toLowerCase() === 's') {
                e.preventDefault(); document.getElementById('searchInput').focus();
            }
            if(e.key === 'Escape') {
                document.getElementById('searchInput').value = '';
                document.getElementById('searchInput').dispatchEvent(new Event('input'));
                document.getElementById('searchInput').blur();
            }
        });

        // Copy Notes
        function copyNotes() {
            let text = document.getElementById('main-content').innerText;
            navigator.clipboard.writeText("Bohr-Bury Notes\n\n" + text).then(() => {
                alert("Notes copied to clipboard!");
            });
        }

        // Download TXT
        function downloadTxt() {
            let text = document.getElementById('main-content').innerText;
            const blob = new Blob(["Bohr-Bury Complete Notes\n\n" + text], {type: "text/plain"});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "Bohr-Bury_Notes.txt";
            a.click();
            URL.revokeObjectURL(url);
        }

        // --- 2. Core Chemistry Logic & Generator ---

        // Robust function to get configuration up to 118 based on standard rules + Aufbau mapping
        function getElectronicConfiguration(Z) {
            // Hardcode standard exceptions for school-level accuracy
            const exceptions = {
                24: [2,8,13,1], 29: [2,8,18,1], 41: [2,8,18,12,1],
                42: [2,8,18,13,1], 44: [2,8,18,15,1], 45: [2,8,18,16,1],
                46: [2,8,18,18], 47: [2,8,18,18,1], 78: [2,8,18,32,17,1],
                79: [2,8,18,32,18,1]
            };
            if(exceptions[Z]) return exceptions[Z];

            // Map Aufbau sequence to shells
            const orbitals = [
                {n:1, max:2}, {n:2, max:2}, {n:2, max:6}, {n:3, max:2}, {n:3, max:6},
                {n:4, max:2}, {n:3, max:10}, {n:4, max:6}, {n:5, max:2}, {n:4, max:10},
                {n:5, max:6}, {n:6, max:2}, {n:4, max:14}, {n:5, max:10}, {n:6, max:6},
                {n:7, max:2}, {n:5, max:14}, {n:6, max:10}, {n:7, max:6}
            ];
            
            let remaining = Z;
            let shells = [];
            for(let orb of orbitals) {
                if(remaining <= 0) break;
                let fill = Math.min(remaining, orb.max);
                if(!shells[orb.n - 1]) shells[orb.n - 1] = 0;
                shells[orb.n - 1] += fill;
                remaining -= fill;
            }
            return shells;
        }

        const elementsData = [
            "", "Hydrogen (H)", "Helium (He)", "Lithium (Li)", "Beryllium (Be)", "Boron (B)", "Carbon (C)",
            "Nitrogen (N)", "Oxygen (O)", "Fluorine (F)", "Neon (Ne)", "Sodium (Na)", "Magnesium (Mg)",
            "Aluminum (Al)", "Silicon (Si)", "Phosphorus (P)", "Sulfur (S)", "Chlorine (Cl)", "Argon (Ar)",
            "Potassium (K)", "Calcium (Ca)", "Scandium (Sc)", "Titanium (Ti)", "Vanadium (V)", "Chromium (Cr)",
            "Manganese (Mn)", "Iron (Fe)", "Cobalt (Co)", "Nickel (Ni)", "Copper (Cu)", "Zinc (Zn)"
        ];

        function generateConfig() {
            let Z = parseInt(document.getElementById('atomicNum').value);
            if(isNaN(Z) || Z < 1 || Z > 118) {
                alert("Please enter a valid Atomic Number between 1 and 118.");
                return;
            }

            let config = getElectronicConfiguration(Z);
            let shellNames = ['K', 'L', 'M', 'N', 'O', 'P', 'Q'];
            
            let htmlStr = `<strong>Element:</strong> Atomic No. ${Z} <br><br>`;
            htmlStr += `<strong>Configuration:</strong> <span style="color:var(--neon-cyan); font-size:1.3rem;">${config.join(', ')}</span><br><br>`;
            htmlStr += `<table style="font-size:0.9rem; margin-top:10px;"><tr>`;
            config.forEach((c, i) => { htmlStr += `<th>${shellNames[i]} Shell</th>`; });
            htmlStr += `</tr><tr>`;
            config.forEach(c => { htmlStr += `<td>${c} e⁻</td>`; });
            htmlStr += `</tr></table><br>`;
            htmlStr += `<strong>Total Shells Occupied:</strong> ${config.length}<br>`;
            htmlStr += `<strong>Valence Shell:</strong> ${shellNames[config.length-1]} Shell<br>`;
            htmlStr += `<strong>Valence Electrons:</strong> ${config[config.length-1]}<br>`;

            document.getElementById('result-box').innerHTML = htmlStr;
            document.getElementById('result-box').style.display = 'block';

            drawAtomSVG(config);
        }

        // Draw Dynamic SVG Diagram
        function drawAtomSVG(config) {
            let svg = document.getElementById('svg-container');
            svg.innerHTML = ''; // Clear existing
            
            let cx = 250, cy = 250;
            
            // Draw Nucleus
            let nucleus = `<circle cx="${cx}" cy="${cy}" r="15" class="nucleus" />`;
            let text = `<text x="${cx}" y="${cy+4}" fill="#000" font-size="12" font-weight="bold" text-anchor="middle">N</text>`;
            svg.innerHTML += nucleus + text;

            // Draw Shells and Electrons
            config.forEach((electrons, index) => {
                let radius = 40 + (index * 30); // spacing between shells
                
                // Group for rotation animation
                let g = document.createElementNS("http://www.w3.org/2000/svg", "g");
                // Center transform origin for animation
                g.style.transformOrigin = `${cx}px ${cy}px`;
                g.style.animation = `orbit ${10 + index*5}s linear infinite`;

                // Draw Shell Path
                let circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                circle.setAttribute("cx", cx); circle.setAttribute("cy", cy);
                circle.setAttribute("r", radius);
                circle.setAttribute("class", "shell");
                g.appendChild(circle);

                // Draw Electrons
                let angleStep = (2 * Math.PI) / electrons;
                for(let e=0; e<electrons; e++) {
                    let angle = e * angleStep;
                    let ex = cx + radius * Math.cos(angle);
                    let ey = cy + radius * Math.sin(angle);
                    
                    let elCircle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                    elCircle.setAttribute("cx", ex); elCircle.setAttribute("cy", ey);
                    elCircle.setAttribute("r", "4");
                    elCircle.setAttribute("class", "electron");
                    g.appendChild(elCircle);
                }
                svg.appendChild(g);
            });
        }

        // Populate Flashcards (1 to 30)
        function initFlashcards() {
            let grid = document.getElementById('flashcard-grid');
            let html = '';
            for(let i=1; i<=30; i++) {
                let config = getElectronicConfiguration(i).join(', ');
                let name = elementsData[i] || `Element ${i}`;
                html += `
                <div class="flashcard">
                    <div class="flashcard-inner">
                        <div class="flashcard-front">
                            <h3 style="font-size:1.2rem;">Z = ${i}</h3>
                            <p>${name}</p>
                        </div>
                        <div class="flashcard-back">
                            <h3 style="font-size:1.5rem;">${config}</h3>
                            <p>Valence: ${getElectronicConfiguration(i).slice(-1)[0]}</p>
                        </div>
                    </div>
                </div>`;
            }
            grid.innerHTML = html;
        }

        // --- 3. MCQ Quiz Logic ---
        
        const quizData = [
            { q: "What is the formula for the maximum number of electrons in a shell?", options: ["n²", "2n²", "2n", "4n²"], ans: 1 },
            { q: "What is the maximum number of electrons that the M shell (n=3) can hold?", options: ["8", "18", "32", "2"], ans: 1 },
            { q: "According to Bohr-Bury, the outermost shell cannot have more than how many electrons?", options: ["2", "18", "8", "32"], ans: 2 },
            { q: "What is the electronic configuration of Sodium (Atomic No. 11)?", options: ["2, 8, 1", "2, 9", "2, 8", "2, 8, 2"], ans: 0 },
            { q: "Which shell is closest to the nucleus?", options: ["L", "M", "N", "K"], ans: 3 },
            { q: "How many valence electrons does Chlorine (Atomic No. 17, Config: 2,8,7) have?", options: ["1", "7", "8", "17"], ans: 1 },
            { q: "An element has configuration 2, 4. Which element is this?", options: ["Oxygen", "Nitrogen", "Carbon", "Boron"], ans: 2 },
            { q: "The penultimate (second outermost) shell cannot have more than ___ electrons.", options: ["8", "18", "32", "2"], ans: 1 },
            { q: "Electronic configuration of Calcium (Atomic No. 20) is:", options: ["2, 8, 10", "2, 8, 8, 2", "2, 18", "2, 8, 9, 1"], ans: 1 },
            { q: "Elements with 8 electrons in their outermost shell are generally:", options: ["Highly reactive", "Chemically stable (Inert)", "Metals", "Radioactive"], ans: 1 }
        ];

        function initQuiz() {
            let container = document.getElementById('quiz-container');
            let html = '';
            quizData.forEach((q, qIndex) => {
                html += `<div class="quiz-question" id="qdiv_${qIndex}">
                    <h4>Q${qIndex+1}: ${q.q}</h4>
                    <div class="quiz-options">`;
                q.options.forEach((opt, optIndex) => {
                    html += `
                    <label class="quiz-option" id="optLabel_${qIndex}_${optIndex}">
                        <input type="radio" name="q_${qIndex}" value="${optIndex}">
                        ${String.fromCharCode(65 + optIndex)}) ${opt}
                    </label>`;
                });
                html += `</div></div>`;
            });
            container.innerHTML = html;
        }

        function evaluateQuiz() {
            let score = 0;
            quizData.forEach((q, qIndex) => {
                let selected = document.querySelector(`input[name="q_${qIndex}"]:checked`);
                let qDiv = document.getElementById(`qdiv_${qIndex}`);
                
                // Reset styling first
                q.options.forEach((_, optIndex) => {
                    document.getElementById(`optLabel_${qIndex}_${optIndex}`).classList.remove('correct-ans', 'wrong-ans');
                });

                if(selected) {
                    let val = parseInt(selected.value);
                    if(val === q.ans) {
                        score++;
                        document.getElementById(`optLabel_${qIndex}_${val}`).classList.add('correct-ans');
                        qDiv.style.borderColor = "var(--success)";
                    } else {
                        document.getElementById(`optLabel_${qIndex}_${val}`).classList.add('wrong-ans');
                        document.getElementById(`optLabel_${qIndex}_${q.ans}`).classList.add('correct-ans');
                        qDiv.style.borderColor = "var(--danger)";
                    }
                } else {
                    // If not answered, show correct answer anyway
                    document.getElementById(`optLabel_${qIndex}_${q.ans}`).classList.add('correct-ans');
                    qDiv.style.borderColor = "var(--danger)";
                }
                
                // Disable inputs after checking
                let inputs = document.querySelectorAll(`input[name="q_${qIndex}"]`);
                inputs.forEach(input => input.disabled = true);
            });

            // Update Scorecard
            document.getElementById('scorecard').style.display = 'block';
            document.getElementById('score-circle').innerText = `${score}/10`;
            document.getElementById('score-correct').innerText = score;
            document.getElementById('score-wrong').innerText = 10 - score;
            document.getElementById('btn-restart').style.display = 'inline-block';
            
            let msgBox = document.getElementById('score-msg');
            if(score === 10) msgBox.innerText = "🏆 Perfect Score! Excellent work!";
            else if(score >= 7) msgBox.innerText = "🌟 Great Job! Keep it up!";
            else msgBox.innerText = "📚 Keep Practicing! You'll get it next time.";
            
            // Scroll to scorecard
            document.getElementById('scorecard').scrollIntoView({behavior: 'smooth', block: 'center'});
        }

        function restartQuiz() {
            initQuiz();
            document.getElementById('scorecard').style.display = 'none';
            document.getElementById('btn-restart').style.display = 'none';
            document.getElementById('quiz').scrollIntoView({behavior: 'smooth'});
        }

        // Initialize App
        window.onload = function() {
            generateConfig(); // Generate default (Na)
            initFlashcards();
            initQuiz();
        };

    </script>
</body>
</html>