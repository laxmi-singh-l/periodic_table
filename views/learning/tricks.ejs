<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dark Gel Premium Periodic Table</title>
    <style>
        /* Deep Dark Theme & Gel Glass Variables */
        :root {
            --bg-color: #03050a; 
            --text-main: #d1d5db;
            --text-heading: #ffffff;
            --accent-cyan: #00f2fe;
            --accent-pink: #ff0844;
            --accent-gold: #fdfc47;
            --transition: 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, sans-serif;
            scroll-behavior: smooth;
            outline: none !important;
            -webkit-tap-highlight-color: transparent;
        }

        /* Animated Deep Dark Background */
        body {
            background: linear-gradient(-45deg, #050510, #130a1a, #05101a, #0a0a0a);
            background-size: 400% 400%;
            animation: gradientBG 25s ease infinite;
            color: var(--text-main);
            line-height: 1.7;
            overflow-x: hidden;
            min-height: 100vh;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Molecule Canvas */
        #molecule-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            opacity: 0.7; 
        }

        /* Main Container */
        main {
            max-width: 1000px;
            margin: 0 auto;
            padding: 3rem 1rem;
            position: relative;
            z-index: 1;
        }

        /* --- GEL GLASSMORPHISM CLASS --- */
        .glass-gel {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-left: 1px solid rgba(255, 255, 255, 0.15); 
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), inset 0 2px 10px rgba(255, 255, 255, 0.03);
            border-radius: 20px;
        }

        /* Hero Section */
        header#hero {
            text-align: center;
            padding: 4rem 2rem;
            margin-bottom: 3.5rem;
        }

        header#hero h1 {
            font-size: 3.2rem;
            color: var(--text-heading);
            margin-bottom: 1rem;
            letter-spacing: 1px;
        }

        header#hero h1 span {
            background: linear-gradient(to right, var(--accent-cyan), var(--accent-gold));
            -webkit-background-clip: text;
            background-clip: text;          /* ✅ standard property added */
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
        }

        header#hero p {
            font-size: 1.15rem;
            margin-bottom: 2rem;
            max-width: 650px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Premium Gel Buttons */
        .btn {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-heading);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 0.8rem 2.2rem;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            border-radius: 30px;
            transition: all var(--transition);
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn:hover, .btn.active {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.3), rgba(255, 8, 68, 0.3));
            border-color: var(--accent-cyan);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 242, 254, 0.4), inset 0 0 15px rgba(255, 255, 255, 0.1);
        }

        /* Tabs Navigation */
        .tabs-container {
            margin-bottom: 3rem;
        }

        .tabs {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 1.2rem;
            flex-wrap: wrap;
        }

        /* Learning Cards */
        section {
            display: none;
            animation: fadeIn 0.5s ease forwards;
        }

        section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card {
            padding: 2.5rem;
            margin-bottom: 2rem;
            transition: transform var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-pink));
        }

        .card h3 {
            color: var(--text-heading);
            margin-bottom: 1.2rem;
            font-size: 1.4rem;
            font-weight: 700;
        }

        .trick-highlight {
            display: inline-block;
            background: rgba(0, 0, 0, 0.5);
            padding: 1.2rem 1.8rem;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0.5rem 0;
            font-size: 1.25rem;
            color: #fff;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);
        }

        .elem-symbol {
            color: var(--accent-gold);
            font-weight: 800;
            text-shadow: 0 0 10px rgba(253, 252, 71, 0.3);
        }

        .meaning {
            font-style: italic;
            color: #9ca3af;
            display: block;
            margin-top: 1rem;
            font-size: 1rem;
            margin-bottom: 1.5rem;
        }

        /* --- DETAILED MAPPING BOXES --- */
        .element-mapping {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
            margin-top: 1rem;
        }

        .map-box {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 15px 10px;
            text-align: center;
            transition: all var(--transition);
            box-shadow: inset 0 0 10px rgba(255,255,255,0.02);
        }

        .map-box:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(0, 242, 254, 0.3);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
        }

        .map-trick {
            font-size: 0.9rem;
            color: #9ca3af;
            margin-bottom: 8px;
            font-style: italic;
        }

        .map-symbol {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-cyan);
            text-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
        }

        .map-name {
            font-size: 0.95rem;
            color: #fff;
            margin-top: 8px;
            font-weight: 500;
        }

        /* ---------- NEW: BACK LINK (Gel style, top-left corner, glow hover) ---------- */
        .back-link-gel {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 999;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 30px;
            color: #d1d5db;
            text-decoration: none;
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6), 0 0 8px rgba(0, 242, 254, 0.2);
            white-space: nowrap;
        }
        .back-link-gel:hover {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.2), rgba(255, 8, 68, 0.2));
            border-color: rgba(0, 242, 254, 0.5);
            color: #ffffff;
            box-shadow: 0 0 22px rgba(0, 242, 254, 0.5), inset 0 0 10px rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }
        .back-link-gel svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.5;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            header#hero { padding: 3rem 1.5rem; }
            header#hero h1 { font-size: 2.3rem; }
            .element-mapping { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 600px) {
            .back-link-gel {
                top: 12px;
                left: 12px;
                padding: 8px 16px;
                font-size: 0.8rem;
            }
            .back-link-gel svg { width: 14px; height: 14px; }
        }
    </style>
</head>
<body>

    <!-- ✅ BACK LINK TO LEARNING PAGE (top left corner) -->
    <a href="/learning" class="back-link-gel" title="Back to Learning Dashboard" aria-label="Go back to Learning page">
        <svg viewBox="0 0 24 24" aria-hidden="true">
