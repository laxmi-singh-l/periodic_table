    <script>
        // Tab switching logic
        function openTab(tabId, btnElement) {
            document.querySelectorAll('main section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.tabs .btn').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            btnElement.classList.add('active');
        }

        // --- Deep Dark Theme Molecule Canvas Animation ---
        const canvas = document.getElementById('molecule-canvas');
        const ctx = canvas.getContext('2d');
        let atomsArray;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        class Atom {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 1; 
                this.speedX = (Math.random() - 0.5) * 0.5;
                this.speedY = (Math.random() - 0.5) * 0.5;
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width || this.x < 0) this.speedX = -this.speedX;
                if (this.y > canvas.height || this.y < 0) this.speedY = -this.speedY;
            }
            draw() {
                // Subtle cyan atoms for dark theme
                ctx.fillStyle = 'rgba(0, 242, 254, 0.4)';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initCanvas() {
            atomsArray = [];
            let numOfAtoms = (canvas.height * canvas.width) / 10000;
            for (let i = 0; i < numOfAtoms; i++) {
                atomsArray.push(new Atom());
            }
        }

        function animateMolecules() {
            requestAnimationFrame(animateMolecules);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            for (let i = 0; i < atomsArray.length; i++) {
                atomsArray[i].update();
                atomsArray[i].draw();
                
                // Draw Molecule Bonds
                for (let j = i; j < atomsArray.length; j++) {
                    let dx = atomsArray[i].x - atomsArray[j].x;
                    let dy = atomsArray[i].y - atomsArray[j].y;
                    let distance = Math.sqrt(dx * dx + dy * dy);
                    
                    if (distance < 100) { 
                        ctx.beginPath();
                        ctx.strokeStyle = `rgba(255, 255, 255, ${0.1 - distance/1000})`; // Very faint white lines
                        ctx.lineWidth = 1;
                        ctx.moveTo(atomsArray[i].x, atomsArray[i].y);
                        ctx.lineTo(atomsArray[j].x, atomsArray[j].y);
                        ctx.stroke();
                    }
                }
            }
        }

        window.addEventListener('resize', function() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            initCanvas();
        });

        initCanvas();
        animateMolecules();
    </script>
